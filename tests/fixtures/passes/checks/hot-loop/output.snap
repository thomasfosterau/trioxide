//- input.ts
export function simulate(steps) {
	const all_1 = [];
	for (let i_1 = 0; i_1 < 64; i_1++) {
		all_1.push({
			x: i_1,
			v: i_1 % 7 - 3
		});
	}
	const all = all_1;
	let total = 0;
	for (let step = 0; step < steps; step++) {
		for (let i = 0; i < all.length; i++) {
			const p = all[i];
			p.x += p.v * .5;
			total += p.x;
		}
	}
	return total;
}
export function main() {
	console.log(simulate(100));
}
