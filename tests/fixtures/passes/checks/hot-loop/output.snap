//- input.ts
function particles() {
	const all = [];
	for (let i = 0; i < 64; i++) {
		all.push({
			x: i,
			v: i % 7 - 3
		});
	}
	return all;
}
export function simulate(steps) {
	const all = particles();
	let total = 0;
	for (let step = 0; step < steps; step++) {
		for (let i = 0; i < all.length; i++) {
			const p = all[i];
			p.x += p.v * .5;
			total += p.x;
		}
	}
	return total;
}
export function main() {
	console.log(simulate(100));
}
