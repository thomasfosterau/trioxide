//- input.ts
// Adversarial cases for check elimination.
function castAway() {
	// A cast doesn't make a value non-null: the analysis knows it may be null.
	const value = Math.random() > 2 ? { x: 1 } : null;
	return value?.x;
}
function shadowed(undefined) {
	return 1 === undefined;
}
function getterChain() {
	let reads = 0;
	const box = { get inner() {
		reads++;
		return reads > 1 ? { y: 2 } : undefined;
	} };
	// The getter runs on each read and may return undefined.
	return [
		box.inner?.y,
		box.inner?.y,
		reads
	];
}
function typeofEffects() {
	let calls = 0;
	const f = () => {
		calls++;
		return 1;
	};
	// The operand has effects, so the comparison stays.
	return [typeof f() === "number", calls];
}
export function main() {
	let input;
	console.log(castAway(), shadowed(1), shadowed(2), getterChain(), typeofEffects());
	console.log("string", (input = JSON.parse("1"), typeof input === "string" ? "string" : "other"));
}
