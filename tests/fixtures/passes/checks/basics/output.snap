//- input.ts
function chains() {
	const p = { x: 1 };
	const maybe = Math.random() > 2 ? null : p;
	// p and f are never nullish; maybe may be null.
	return [
		p.x,
		2,
		undefined,
		maybe?.x
	];
}
export function main() {
	console.log(chains(), [0, "fallback"], "number", "number");
}
