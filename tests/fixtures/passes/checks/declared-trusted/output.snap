//- input.ts
// The negative cases with trustTypes: the declared types count, so the checks fold.
export function read(point, value) {
	return [
		point.x,
		value,
		true,
		point == null
	];
}
export function main() {
	let point;
	console.log((point = { x: 1 }, [
		point.x,
		2,
		true,
		point == null
	]));
}
