//- input.ts
const map_callback_5 = (x) => {
	if (x === 2) {
		return 0;
	}
	return x;
};
const map_callback_4 = (x, i) => x * 10 + i;
const filter_callback = (x) => x !== 6;
const map_callback_2 = (x, i, all) => x + all.length;
const map_callback_3 = (x) => x * 2;
const map_callback_1 = function() {
	// eslint-disable-next-line prefer-rest-params
	return arguments.length;
};
const map_callback = function(x) {
	return x * this.by;
};
// Adversarial: chains that must stay calls (or keep their exact semantics).
function thisArg() {
	const scale = { by: 3 };
	// A function callback reads `this`, which the `thisArg` sets.
	return [1, 2].map(map_callback, scale);
}
function selfReference() {
	// A named function expression that refers to itself (on a path these elements don't take).
	return [3, 4].map(function again(n) {
		return n > 100 ? again(0) : n * 2;
	});
}
function usesArguments() {
	return [5, 6].map(map_callback_1);
}
function intermediate() {
	// The second callback receives the intermediate array.
	return [
		1,
		2,
		3
	].map(map_callback_3).map(map_callback_2);
}
function afterFilter() {
	// The index after a `filter` is the filtered array's.
	return [
		5,
		6,
		7
	].filter(filter_callback).map(map_callback_4);
}
function startIndex() {
	return [
		1,
		2,
		3
	].includes(1, 1);
}
function zeros() {
	const xs = [-0, NaN];
	// SameValueZero: -0 equals 0, and NaN equals NaN.
	let found = false;
	for (let i = 0, length = xs.length; i < length; i++) {
		const item = xs[i];
		if (item === 0) {
			found = true;
			break;
		}
	}
	const zero = found;
	let found2 = false;
	for (let i = 0, length = xs.length; i < length; i++) {
		const item = xs[i];
		if (item === NaN || item !== item && true) {
			found2 = true;
			break;
		}
	}
	const nan = found2;
	return [
		zero,
		nan,
		xs.indexOf(NaN) === -1
	];
}
function tdz() {
	try {
		// The callback reads the binding the chain initialises, in its temporal dead zone.
		const items = [1];
		const result = new Array(items.length);
		for (let i = 0, length = items.length; i < length; i++) {
			if (!(i in items)) continue;
			const v = t.length;
			result[i] = v;
		}
		const t = result;
		return String(t);
	} catch (error) {
		return error instanceof ReferenceError ? "ReferenceError" : "other";
	}
}
function asyncCallback() {
	const promises = [1, 2].map(async (x) => x);
	return promises.length;
}
function earlyReturn() {
	return [
		1,
		2,
		3
	].map(map_callback_5);
}
export function main() {
	console.log(thisArg());
	console.log(selfReference(), usesArguments(), intermediate(), afterFilter());
	console.log(startIndex(), zeros(), tdz(), asyncCallback(), earlyReturn());
}
