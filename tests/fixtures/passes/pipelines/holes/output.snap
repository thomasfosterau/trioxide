//- input.ts
// Adversarial: arrays with holes. `map` keeps holes; `filter`, `forEach`, `reduce`, `some`
// and `every` skip them; `find`, `findIndex` and `includes` visit them as `undefined`; and
// `reduce` with no seed throws on an empty range.
function holey() {
	// eslint-disable-next-line no-sparse-arrays
	const a = [
		1,
		,
		3
	];
	return a;
}
function deleted() {
	const a = [
		4,
		5,
		6
	];
	delete a[1];
	return a;
}
function grown() {
	const a = [7];
	a.length = 3;
	return a;
}
function report() {
	const a = holey();
	const doubled = new Array(a.length);
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		doubled[i] = (x ?? 0) * 2;
	}
	console.log(doubled, 1 in doubled, doubled.length);
	const kept = [];
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const item = a[i];
		kept.push(item);
	}
	console.log(kept, kept.length);
	let visits = 0;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		visits++;
	}
	console.log(visits);
	let sum = 0;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		sum = sum + (x ?? 100);
	}
	let count = false;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		if (x === undefined) {
			count = true;
			break;
		}
	}
	let every = true;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		if (!(x !== undefined)) {
			every = false;
			break;
		}
	}
	console.log(sum, count, every);
	let found = -1;
	for (let i = 0, length = a.length; i < length; i++) {
		const x = a[i];
		if (x === undefined) {
			found = i;
			break;
		}
	}
	let has = false;
	for (let i = 0, length = a.length; i < length; i++) {
		const item = a[i];
		if (item === undefined) {
			has = true;
			break;
		}
	}
	let which;
	for (let i = 0, length = a.length; i < length; i++) {
		const x = a[i];
		if (x === undefined) {
			which = x;
			break;
		}
	}
	console.log(found, has, which);
	// A hole a `map` keeps would reach `find`: this chain stays.
	const passed = a.map((x) => x).find((x) => x === undefined);
	console.log(passed);
	const d = deleted();
	const plusOne = d.map((x) => x + 1);
	const total = d.reduce((s, x) => s + x, 0);
	console.log(plusOne, total);
	const g = grown();
	const tripled = new Array(g.length);
	for (let i = 0, length = g.length; i < length; i++) {
		if (!(i in g)) continue;
		const x = g[i];
		tripled[i] = x * 3;
	}
	const positive = [];
	for (let i = 0, length = g.length; i < length; i++) {
		if (!(i in g)) continue;
		const x = g[i];
		if (!(x > 0)) continue;
		positive.push(x);
	}
	console.log(tripled, positive);
}
function empty() {
	const none = [];
	try {
		return String(none.reduce((a, b) => a + b));
	} catch (error) {
		return error.message;
	}
}
function allHoles() {
	const a = new Array(3);
	try {
		return String(a.reduce((x, y) => x + y));
	} catch (error) {
		return error instanceof TypeError ? "TypeError" : "other";
	}
}
export function main() {
	report();
	console.log(empty(), allHoles());
}
