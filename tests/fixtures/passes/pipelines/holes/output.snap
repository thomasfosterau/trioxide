//- input.ts
const reduce_callback_2 = (x, y) => x + y;
const reduce_callback_1 = (a, b) => a + b;
const reduce_callback = (s, x) => s + x;
const map_callback_1 = (x) => x + 1;
const find_callback = (x) => x === undefined;
const map_callback = (x) => x;
// Adversarial: arrays with holes. `map` keeps holes; `filter`, `forEach`, `reduce`, `some`
// and `every` skip them; `find`, `findIndex` and `includes` visit them as `undefined`; and
// `reduce` with no seed throws on an empty range.
function holey() {
	// eslint-disable-next-line no-sparse-arrays
	const a = [
		1,
		,
		3
	];
	return a;
}
function deleted() {
	const a = [
		4,
		5,
		6
	];
	delete a[1];
	return a;
}
function grown() {
	const a = [7];
	a.length = 3;
	return a;
}
function report() {
	const a = holey();
	const result = new Array(a.length);
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		result[i] = (x ?? 0) * 2;
	}
	const doubled = result;
	console.log(doubled, 1 in doubled, doubled.length);
	const result2 = [];
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const item = a[i];
		result2.push(item);
	}
	const kept = result2;
	console.log(kept, kept.length);
	let visits = 0;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		visits++;
	}
	console.log(visits);
	let result3 = 0;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		result3 = result3 + (x ?? 100);
	}
	const sum = result3;
	let found2 = false;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		if (x === undefined) {
			found2 = true;
			break;
		}
	}
	const count = found2;
	let all = true;
	for (let i = 0, length = a.length; i < length; i++) {
		if (!(i in a)) continue;
		const x = a[i];
		if (!(x !== undefined)) {
			all = false;
			break;
		}
	}
	const every = all;
	console.log(sum, count, every);
	let index = -1;
	for (let i = 0, length = a.length; i < length; i++) {
		const x = a[i];
		if (x === undefined) {
			index = i;
			break;
		}
	}
	const found = index;
	let found3 = false;
	for (let i = 0, length = a.length; i < length; i++) {
		const item = a[i];
		if (item === undefined) {
			found3 = true;
			break;
		}
	}
	const has = found3;
	let found4;
	for (let i = 0, length = a.length; i < length; i++) {
		const x = a[i];
		if (x === undefined) {
			found4 = x;
			break;
		}
	}
	const which = found4;
	console.log(found, has, which);
	// A hole a `map` keeps would reach `find`: this chain stays.
	const passed = a.map(map_callback).find(find_callback);
	console.log(passed);
	const d = deleted();
	const plusOne = d.map(map_callback_1);
	const total = d.reduce(reduce_callback, 0);
	console.log(plusOne, total);
	const g = grown();
	const result4 = new Array(g.length);
	for (let i = 0, length = g.length; i < length; i++) {
		if (!(i in g)) continue;
		const x = g[i];
		result4[i] = x * 3;
	}
	const tripled = result4;
	const result5 = [];
	for (let i = 0, length = g.length; i < length; i++) {
		if (!(i in g)) continue;
		const x = g[i];
		if (!(x > 0)) continue;
		result5.push(x);
	}
	const positive = result5;
	console.log(tripled, positive);
}
function empty() {
	const none = [];
	try {
		return String(none.reduce(reduce_callback_1));
	} catch (error) {
		return error.message;
	}
}
function allHoles() {
	const a = new Array(3);
	try {
		return String(a.reduce(reduce_callback_2));
	} catch (error) {
		return error instanceof TypeError ? "TypeError" : "other";
	}
}
export function main() {
	report();
	console.log(empty(), allHoles());
}
