//- input.ts
const map_callback_2 = (v) => v * 2;
const map_callback_1 = (v, i) => `${i}:${v}`;
const map_callback = (v) => v * 2;
// A chain that is one `map` stays the builtin call (nothing to fuse); a `map` feeding another
// stage still becomes a loop.
const rows = [];
for (let i = 0; i < 8; i++) rows.push([
	i,
	i + 1,
	i + 2,
	i + 3
]);
function doubled(row) {
	return row.map(map_callback);
}
function labels(row) {
	const out = row.map(map_callback_1);
	return out;
}
function sumOfSquares(row) {
	let result = 0;
	for (let i = 0, length = row.length; i < length; i++) {
		const v = row[i];
		const b = v * v;
		result = result + b;
	}
	return result;
}
function evensDoubled(row) {
	const result = [];
	for (let i = 0, length = row.length; i < length; i++) {
		const v = row[i];
		if (!(v % 2 === 0)) continue;
		result.push(v * 2);
	}
	return result;
}
export function main() {
	let total = 0;
	for (let i = 0; i < rows.length; i++) {
		const row = rows[i];
		const d = doubled(row);
		total += d[3] + sumOfSquares(row) + evensDoubled(row).length;
		console.log(labels(row).join(" "));
	}
	console.log(total, doubled([]).length, [
		1,
		,
		3
	].map(map_callback_2).length);
}
