const map_callback_2 = (s) => s.length + ":" + s.charCodeAt(0);
const map_callback_1 = (x) => Object.is(x, -0) ? "-0" : String(x);
const map_callback = (s) => s.length;
// Calls partial evaluation must leave alone (or get exactly right).
let counter = 0;
function bumped() {
	counter++;
	return counter;
}
function random() {
	return Math.random() < 2 ? 1 : 0;
}
function now() {
	return Date.now() > 0 ? 1 : 0;
}
function readsLet() {
	return counter + 1;
}
function throws(n) {
	if (n > 0) throw new Error("no");
	return n;
}
function forever() {
	let i = 0;
	while (true) i++;
}
function shared() {
	const row = [1, 2];
	return [row, row];
}
function big() {
	const out = [];
	for (let i = 0; i < 1e3; i++) out.push(i);
	return out;
}
function usesLater() {
	return AFTER + 1;
}
function loneLiteral() {
	return "\ud83d";
}
function invisible() {
	return "a​b";
}
function slow() {
	let s = 0;
	for (let i = 0; i < 1e6; i++) s = (s + i) % 7;
	return s;
}
function loopTdz() {
	let s = 0;
	for (let i = 0; i < 3; i++) {
		if (i > 0) s += y;
		const y = i;
	}
	return s;
}
function holes() {
	return new Array(3);
}
function transcendental() {
	return Math.sin(1);
}
const C1 = bumped();
const C2 = random();
const C3 = now();
const C4 = readsLet();
let C5 = 0;
try {
	C5 = throws(1);
} catch {
	C5 = -1;
}
const C6 = shared();
const C7 = big().length;
let C8 = 0;
try {
	C8 = usesLater();
} catch {
	C8 = -1;
}
const AFTER = 5;
const C9 = 42;
const C10 = [
	"tab	here",
	"é",
	"quote\"s"
];
const C11 = holes();
const C12 = transcendental();
const C13 = [
	1.4142135623730951,
	.10000000149011612,
	4503599627370497,
	-2147483648,
	1,
	-1,
	-Infinity
];
const C14 = [
	"\ud800x",
	loneLiteral(),
	invisible()
];
const C15 = slow();
let C16 = "";
try {
	C16 = String(loopTdz());
} catch (e) {
	C16 = e.name;
}
const C18 = 65;
export function main() {
	C6[0][0] = 9;
	console.log(C1, C2, C3, C4, C5, C6[1][0], C7, C8, C9);
	console.log(C10.map(map_callback).join(","), C11.length, 0 in C11, C12 > .84);
	console.log(C13.map(map_callback_1).join(","));
	console.log(C16, C18);
	console.log(C14.map(map_callback_2).join(","), C15, typeof forever);
}
