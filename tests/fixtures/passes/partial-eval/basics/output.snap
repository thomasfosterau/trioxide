//- input.ts
const SQUARES = [
	0,
	1,
	4,
	9,
	16,
	25,
	36,
	49
];
const CRC = [
	0,
	94,
	188,
	226,
	97,
	63,
	221,
	131,
	194,
	156,
	126,
	32,
	163,
	253,
	31,
	65
];
const LABEL = {
	name: "trioxide",
	version: 2,
	tag: "trioxide@2"
};
const NUMBERS = [
	-0,
	NaN,
	Infinity,
	5e-324,
	9007199254740992,
	.30000000000000004,
	-0,
	0
];
function map_callback(x) {
	return Object.is(x, -0) ? "-0" : String(x);
}
export function main() {
	console.log(SQUARES.join(","), CRC.join(","), LABEL.tag, 2);
	console.log(NUMBERS.map(map_callback).join(","));
}
