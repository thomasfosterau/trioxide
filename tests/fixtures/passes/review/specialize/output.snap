//- input.ts
function bounded(arr) {
	let total = 0;
	for (let i = 0, lastIndex = arr.length - 1; i <= lastIndex; i++) {
		total += arr[i];
	}
	return total;
}
class Point {
	x;
	y;
	constructor(x, y) {
		this.x = x;
		this.y = y;
	}
	/** The distance from the origin. */
	length() {
		return Math.sqrt(this.x * this.x + this.y * this.y);
	}
}
function guard(n) {
	if (n > 3) {
		return "big";
	}
	return "small";
}
function scale(x) {
	return x * 10;
}
export function main() {
	console.log(3, bounded([1, 2]), new Point(3, 4).length(), scale(2.5), guard(4));
}
