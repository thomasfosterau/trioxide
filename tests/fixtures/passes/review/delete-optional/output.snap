//- input.ts
// Review: a `delete` is never pure, so it is never removed, and `checks` may drop its `?.`
// only when the object is proven non-nullish (so the delete still happens).
function optional() {
	const p = { late: 2 };
	delete p.late;
	return p.late;
}
function plain() {
	const q = { late: 3 };
	delete q.late;
	return q.late;
}
function nullish() {
	const r = Math.random() > 2 ? { late: 4 } : undefined;
	delete r?.late;
	return String(r);
}
function result() {
	const s = { late: 5 };
	const removed = delete s.late;
	return removed && !("late" in s);
}
function wrapped() {
	const t = {
		a: 6,
		b: 7
	};
	// A parenthesised or type-asserted operand is still the property.
	delete t.a;
	delete t.b;
	return `${t.a} ${t.b}`;
}
function nested() {
	const u = { inner: { late: 8 } };
	delete u.inner.late;
	return u.inner.late;
}
export function main() {
	console.log(optional(), plain(), nullish(), result(), wrapped(), nested());
}
