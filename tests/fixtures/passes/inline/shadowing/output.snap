//- input.ts
// Values whose names are shadowed where they land: `Infinity`, `NaN` and `undefined` are
export function main() {
	console.log([
		undefined,
		Infinity,
		-Infinity,
		NaN,
		1,
		2,
		3
	], [
		undefined,
		Infinity,
		-Infinity,
		NaN,
		4,
		5,
		6
	], [
		undefined,
		Infinity,
		-Infinity,
		NaN
	]);
}
