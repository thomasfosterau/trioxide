//- input.ts
const map_callback = (x) => Object.is(x, -0);
// Adversarial cases for folding.
const counter = {
	reads: 0,
	get value() {
		this.reads++;
		return 1;
	}
};
const coercing = { valueOf() {
	console.log("valueOf ran");
	return 2;
} };
function hoisting() {
	// The branch never runs, but its `var` is visible outside it.
	if (Math.random() > 2) {
		var hoisted = 1;
	}
	return hoisted;
}
function sideEffects() {
	let n = 0;
	// The comparison is decided, but evaluating it writes n.
	if ((n = 5) > 10) {
		return -1;
	}
	return 5;
}
export function main() {
	let Math_1;
	console.log(counter.value + counter.value, counter.reads, +coercing * 1, hoisting());
	console.log((Math_1 = { floor: (x) => x * 10 }, [
		0 / 0,
		1 / 0,
		-Infinity,
		Math_1.floor(2.5),
		1,
		2
	]));
	console.log([
		Math.max(-0, 0),
		Math.min(0, -0),
		Math.max(0, -0),
		Math.abs(-0)
	].map(map_callback), sideEffects());
}
