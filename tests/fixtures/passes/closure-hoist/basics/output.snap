//- input.ts
const map_callback = (v) => v * 2;
function weight(v) {
	return v * 3 + 1;
}
function weights(n) {
	let total = 0;
	for (let i = 0; i < n; i++) {
		total += weight(i);
	}
	return total;
}
function doubled(values) {
	return values.map(map_callback);
}
export function main() {
	console.log(weights(5), doubled([
		1,
		2,
		3
	]).join(","));
}
