//- input.ts
const map_callback = (v) => v * 2;
function weights(n) {
	let total = 0;
	for (let i = 0; i < n; i++) {
		total += i * 3 + 1;
	}
	return total;
}
export function main() {
	console.log(weights(5), [
		1,
		2,
		3
	].map(map_callback).join(","));
}
