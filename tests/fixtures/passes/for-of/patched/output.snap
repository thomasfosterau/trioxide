//- input.ts
// Adversarial: a program that replaces the array iterator. Reaching `Array.prototype` turns
// the builtin models off, so no loop is lowered.
const original = Array.prototype[Symbol.iterator];
let steps = 0;
Array.prototype[Symbol.iterator] = function() {
	steps++;
	return original.call(this);
};
function sum() {
	let total = 0;
	for (const value of [
		1,
		2,
		3
	]) total += value;
	return total;
}
export function main() {
	console.log(sum(), [...[4, 5]], steps);
	Array.prototype[Symbol.iterator] = original;
}
