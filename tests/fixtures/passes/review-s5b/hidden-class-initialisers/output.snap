//- input.ts
// Review: a declared field must not overwrite what an earlier field initialiser set.
class P {
	late = undefined;
	x = this.init();
	init() {
		this.late = 5;
		return 1;
	}
}
export function main() {
	const p = new P();
	console.log(String(p.x) + p.late);
}
