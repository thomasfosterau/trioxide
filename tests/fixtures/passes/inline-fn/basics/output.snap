//- input.ts
function sum(...xs) {
	let s = 0;
	for (const x of xs) s += x;
	return s;
}
export function main() {
	let b;
	let total = 0;
	for (let i = 0; i < 10; i++) {
		let x, y;
		total += (x = i, y = i + 1, x * x + y * y);
		let clamp_result;
		clamp: {
			const v = i * 3;
			if (v < 2) {
				clamp_result = 2;
				break clamp;
			}
			if (v > 20) {
				clamp_result = 20;
				break clamp;
			}
			clamp_result = v;
		}
		const c = clamp_result;
		total += c;
	}
	const message = "total " + total;
	console.log("log:", message);
	console.log(sum(1, 2, 3), (b = 2, 1 + b), 7);
}
