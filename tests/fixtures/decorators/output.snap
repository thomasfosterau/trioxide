//- input.ts
import _decorate from "@oxc-project/runtime/helpers/decorate";
const calls = [];
function logged(target, key, descriptor) {
	const original = descriptor.value;
	descriptor.value = function(...args) {
		calls.push(`${key}(${args.join(", ")})`);
		return original.apply(this, args);
	};
	return descriptor;
}
function sealed(constructor) {
	Object.seal(constructor);
	Object.seal(constructor.prototype);
}
let Calculator = class Calculator {
	add(a, b) {
		return a + b;
	}
	scale(value, factor = 2) {
		return value * factor;
	}
};
_decorate([logged], Calculator.prototype, "add", null);
_decorate([logged], Calculator.prototype, "scale", null);
Calculator = _decorate([sealed], Calculator);
export function main() {
	const calc = new Calculator();
	console.log(calc.add(1, 2), calc.scale(5));
	console.log(calls.join(" "));
	console.log(Object.isSealed(Calculator), Object.isSealed(Calculator.prototype));
}
