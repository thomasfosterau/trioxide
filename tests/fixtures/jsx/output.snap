//- runtime.ts
const map_callback = ([key, value]) => ` ${key}="${String(value)}"`;
export const Fragment = Symbol("Fragment");
export function h(tag, props, ...children) {
	return {
		tag,
		props: props ?? {},
		children
	};
}
export function render(node) {
	if (node === null || node === undefined || typeof node === "boolean") return "";
	if (Array.isArray(node)) return node.map(render).join("");
	if (typeof node !== "object") return String(node);
	if (node.tag === Fragment) return render(node.children);
	if (typeof node.tag === "function") return render(node.tag({
		...node.props,
		children: node.children
	}));
	const attrs = Object.entries(node.props).map(map_callback).join("");
	return `<${String(node.tag)}${attrs}>${render(node.children)}</${String(node.tag)}>`;
}
