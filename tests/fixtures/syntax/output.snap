//- input.ts
const users = [{
	name: "ada",
	email: "ada@example.com",
	address: { city: "London" },
	tags: ["math"]
}, {
	name: "grace",
	tags: []
}];
function cityOf(user) {
	return user.address?.city ?? "unknown";
}
function first(items) {
	return items[0];
}
const DEFAULTS = {
	retries: 3,
	timeout: 1e3
};
function configure({ retries = 3, ...rest }) {
	return {
		retries,
		...DEFAULTS,
		...rest
	};
}
let assigned;
assigned ||= 1;
assigned &&= 2;
label: for (const i of [
	1,
	2,
	3
]) {
	for (const j of [
		1,
		2,
		3
	]) {
		if (i * j === 4) break label;
	}
}
export function main() {
	console.log(users.map(cityOf).join(","), first(users).name);
	console.log(users[1].email?.toUpperCase(), users[0].email.length);
	console.log(JSON.stringify(configure({
		timeout: 5,
		name: "x"
	})));
	const [head, ...tail] = users.flatMap((u) => [u.name, ...u.tags]);
	console.log(head, tail, assigned);
	const big = 2n ** 64n;
	console.log(big.toString(), typeof big, 1e6);
	console.log(`${"tagged"}`.padStart(8, "."), String.raw`a\nb`);
}
