//- input.ts
function make(depth) {
	const children = [];
	if (depth > 0) {
		children.push(make(depth - 1), make(depth - 1));
	}
	return {
		value: depth,
		children
	};
}
function count(tree) {
	let total = 1;
	for (let children = tree.children, i = 0, length = children.length; i < length; i++) {
		const child = children[i];
		total += count(child);
	}
	return total;
}
export function main() {
	const tree = make(3);
	console.log(
		count(tree),
		tree.value
		/*@proven number int*/
	);
}
