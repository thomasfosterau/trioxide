//- input.ts
function lenAssign(a) {
	let t = 0;
	for (let i = 0; i < a.length; i++) {
		a.length = 0;
		t += a[i] ?? 0;
	}
	return t;
}
function alias(a) {
	const b = a;
	let t = 0;
	for (let i = 0; i < a.length; i++) {
		b.pop();
		t += a[i] ?? 0;
	}
	return t;
}
function splice(a) {
	let t = 0;
	for (let i = 0; i < a.length; i++) {
		a.splice(0, 1);
		t += a[i] ?? 0;
	}
	return t;
}
function modI(a) {
	let t = 0;
	for (let i = 0, aLength = a.length; i < aLength; i++) {
		i += 1;
		t += a[i] ?? 0;
	}
	return t;
}
function le(a) {
	let t = 0;
	for (let i = 0, aLength = a.length; i <= aLength; i++) {
		t += a[i] ?? 0;
	}
	return t;
}
function frac(a) {
	let t = 0;
	for (let i = .5, aLength = a.length; i < aLength; i++) {
		t += a[i] ?? 0;
	}
	return t;
}
function neg(a) {
	let t = 0;
	for (let i = -2, aLength = a.length; i < aLength; i++) {
		t += a[i] ?? 0;
	}
	return t;
}
let shared = [
	1,
	2,
	3
];
function shrinkShared() {
	shared.pop();
}
function viaCall() {
	let t = 0;
	for (let i = 0; i < shared.length; i++) {
		shrinkShared();
		t += shared[i] ?? 0;
	}
	return t;
}
function cb(a) {
	let t = 0;
	for (let i = 0; i < a.length; i++) {
		const items = [0];
		for (let j = 0, length = items.length; j < length; j++) {
			if (!(j in items)) continue;
			a.pop();
		}
		t += a[i] ?? 0;
	}
	return t;
}
function str(s) {
	let t = 0;
	for (let i = 0; i < s.length; i++) {
		t += s.charCodeAt(i);
		const c = s[i];
		t += c.length;
	}
	return t;
}
function detach(a) {
	let t = 0;
	for (let i = 0; i < a.length; i++) {
		if (i === 1) structuredClone(a.buffer, { transfer: [a.buffer] });
		t += a[i] ?? 0;
	}
	return t;
}
function sub(a) {
	let t = 0;
	const s = a.subarray(0, 2);
	for (let i = 0, aLength = a.length; i < aLength; i++) {
		t += s[i] ?? 0;
	}
	return t;
}
function whileLoop(a) {
	let t = 0;
	let i = 0;
	while (i < a.length) {
		t += a[i];
		i++;
		a.shift();
	}
	return t;
}
function setLen(a) {
	let t = 0;
	const o = { a };
	for (let i = 0; i < a.length; i++) {
		o.a.length = 0;
		t += a[i] ?? 0;
	}
	return t;
}
export function main() {
