//- input.ts
class P {
	x = 1;
}
class Q {
	x = 1;
	grow() {
		this.y = 2;
	}
}
export function main() {
	const p = new P();
	p.z = 3;
	const q = new Q();
	q.y = 2;
	const o = { a: 1 };
