//- input.ts
// Call-site completeness, expression and loop effects, points-to and reachability.
let log = 0;
function bump(n) {
	log += n;
	return n;
}
function square(x) {
	return x * x;
}
function never() {
	return 1;
}
function early(flag) {
	if (flag) {
		return 1;
	}
	return 2;
	log = 99;
}
function loop(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += values[i] * values[i];
	}
	return total;
}
function popping(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		values.pop();
		total += i;
	}
	return total;
}
export function main() {
	const point = { x: 1 };
	const pure = square(3);
	const effect = bump(2);
	const outside = globalThis.unknown?.(1);
	console.log(point.x, pure, effect, outside, early(true), early(false));
	console.log(loop([
		1,
		2,
		3
	]), popping([
		1,
		2,
		3
	]));
}
