//- input.ts
// Call-site completeness, expression and loop effects, points-to and reachability.
const external = JSON.parse("{}");
let log = 0;
function bump(n) {
	log += n;
	return n;
}
function early(flag) {
	if (flag) {
		return 1;
	}
	return 2;
}
function loop(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += values[i] * values[i];
	}
	return total;
}
function popping(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		values.pop();
		total += i;
	}
	return total;
}
function invariant(values, k) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += values[i] + k * 3;
	}
	return total;
}
function guarded(values, o) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		if (o !== null) {
			total += o.x * 2;
		}
	}
	return total;
}
function clock(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += Date.now() * 0;
	}
	return total;
}
function boxed(values) {
	const box = { v: 1 };
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += box.v * 2;
		box.v++;
	}
	return total;
}
function captured(values) {
	let c = 1;
	const inc = () => {
		c++;
	};
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += c * 2;
		inc();
	}
	return total;
}
class Scale {
	factor = 2;
	apply(x) {
		return x * this.factor;
	}
}
function method(values, scale) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		total += scale.apply(i);
	}
	return total;
}
function exits(values, k) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		if (i > 3) {
			break;
		}
		total += k * 5;
	}
	return total;
}
function locals() {
	const arr = [
		7,
		8,
		9
	];
	let t = 0;
	for (let i = 0; i < 3; i++) {
		t += arr[0] * 2;
		arr[0] = i + 10;
		arr.push(i);
	}
	return t;
}
function getter() {
	let k = 0;
	const getK = () => k;
	let t = 0;
	for (let i = 0; i < 3; i++) {
		t += getK() * 1;
		k++;
	}
	return t;
}
function triple(x) {
	return x * 3;
}
function quadruple(x) {
	return x * 4;
}
function callbacks() {
	const mapped = [1, 2].map(triple);
	return mapped[0] + quadruple.call(undefined, 2);
}
function grow(a) {
	a.push(1);
}
function nested() {
	const grown = [11];
	for (let i = 10; i > 0; i -= 2) {
		for (let j = 0; j < i; j++) {
			grow(grown);
		}
	}
	return grown.length;
}
function fractional() {
	let count = 0;
	for (let x = 0; x < 1; x += .25) {
		count += 1;
	}
	return count;
}
// Units the engine calls: their sites must not read as complete.
async function thenable() {
	const t = { then(r) {
		log += 3;
		r(1);
	} };
	return await t;
}
function coerced() {
	const o = {
		toString() {
			this.k();
			return "o";
		},
		k() {
			log += 1;
		}
	};
	return `${o}`;
}
function converted() {
	const o = { valueOf() {
		log += 1;
		return 2.5;
	} };
	return Math.floor(o) + [o].join().length;
}
function promised() {
	return new Promise((resolve) => {
		log += 1;
		resolve(1);
	});
}
export function main() {
	const effect = bump(2);
	const outside = external.unknown?.(1);
	console.log(1, 9, 2, outside, early(true), early(false));
	console.log(loop([
		1,
		2,
		3
	]), popping([
		1,
		2,
		3
	]), invariant([1, 2], 4), invariant([], 5));
	console.log(guarded([1, 2], { x: 3 }), guarded([1], null), clock([1, 2]), boxed([
		1,
		2,
		3
	]));
	void thenable();
	void promised();
	console.log(coerced(), converted(), log, locals(), getter(), callbacks(), nested(), fractional());
	console.log(captured([
		1,
		2,
		3
	]), method([1, 2], new Scale()), exits([
		1,
		2,
		3,
		4,
		5,
		6
	], 2));
}
