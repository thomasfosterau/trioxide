//- input.ts
// Primitive strings: nothing can mutate them, so their methods are pure.
export function main() {
	const upper = "Hello, World".toUpperCase();
	console.log(
		upper,
		"Hello, World".length
		/*@proven number int nonNaN*/
	);
	const index = "Hello, World".indexOf("o");
	console.log(
		index,
		"Hello, World".charCodeAt(0)
		/*@proven number*/
	);
	const parts = "Hello, World".split(", ");
	console.log(
		parts.length,
		"Hello, World"[0]
		/*@proven union*/
	);
	const joined = `${"Hello, World"}!` + 1;
	console.log(
		joined
		/*@proven string*/
	);
	console.log(
		7 .toFixed(2)
		/*@proven string*/
	);
}
