//- input.ts
// Switch fallthrough, labelled breaks and continues.
function classify(n) {
	let kind = "other";
	switch (n % 3) {
		case 0:
			kind = "fizz";
			break;
		case 1:
		case 2:
			kind = n > 10 ? "big" : "small";
			break;
		default: kind = "never";
	}
	return kind;
}
function search(grid, target) {
	let found = -1;
	outer: for (let row = 0, gridLength = grid.length; row < gridLength; row++) {
		for (let column = 0; column < grid[row].length; column++) {
			if (grid[row][column] === target) {
				found = row * 10 + column;
				break outer;
			}
			if (grid[row][column] < 0) continue outer;
		}
	}
	return found;
}
export function main() {
	console.log(classify(3), classify(13), search([[1, 2], [3, 4]], 3));
}
