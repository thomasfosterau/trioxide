//- input.ts
// Destructuring reads properties and iterates; defaults replace undefined.
function options({ size = 1, name }) {
	return name + size;
}
export function main() {
	const [first, second = 10, ...rest] = [
		1,
		2,
		3,
		4
	];
	console.log(first, second, rest.length);
	const { x, y: why, ...others } = {
		x: 1,
		y: "two",
		z: true
	};
	console.log(
		1,
		why,
		others
		/*@proven object*/
	);
	console.log(options({ name: "a" }), options({
		name: "b",
		size: 2
	}));
	let a = 1;
	let b = 2;
	[a, b] = [2, 1];
	console.log(
		a,
		b
		/*@proven union*/
	);
}
