//- input.ts
export function catchThenFinally() {
	let x = 1;
	let out = "";
	try {
		try {
			throw new Error("a");
		} catch {
			x = "s";
			throw new Error("b");
		} finally {
			const seen = x;
			out = String(seen);
		}
	} catch {}
	return out;
}
export function main() {
	console.log(catchThenFinally());
}
