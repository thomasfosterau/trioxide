//- input.ts
// Captured variables: a closure that writes a local makes it flow-insensitive.
export function counter() {
	let count = 0;
	return () => {
		count++;
		return count;
	};
}
export function sharedWrite() {
	let value = 1;
	const set = () => {
		value = "set by closure";
	};
	set();
	// Any call could have run `set`: the value is either.
	return value;
}
export function readOnlyCapture() {
	const add = (x) => x + 10;
	return add(5);
}
export function main() {
	const next = counter();
	next();
	console.log(next(), sharedWrite(), 15);
}
