//- input.ts
// Array reads bounded by `.length` in loop conditions are in bounds; shrinking breaks that.
function sum(values) {
	let total = 0;
	for (let i = 0, valuesLength = values.length; i < valuesLength; i++) {
		total += values[i];
	}
	return total;
}
function cached(values) {
	let total = 0;
	const n = values.length;
	for (let i = 0; i < n; i++) {
		total += values[i];
	}
	return total;
}
function shrinking(values) {
	let total = 0;
	for (let i = 0; i < values.length; i++) {
		values.pop();
		// After a pop, `i` may be past the end.
		const value = values[i];
		total += value ?? 0;
	}
	return total;
}
function backwards(values) {
	let total = 0;
	for (let i = values.length - 1; i >= 0; i--) {
		// Counting down from length - 1 is in range too, but only `i < length` conditions are
		// recognised: the read may be undefined as far as the analysis knows.
		total += values[i] ?? 0;
	}
	return total;
}
export function main() {
	console.log(sum([
		1,
		2,
		3
	]), cached([4, 5]), shrinking([
		1,
		2,
		3,
		4
	]), backwards(new Int32Array([1, 2])));
}
