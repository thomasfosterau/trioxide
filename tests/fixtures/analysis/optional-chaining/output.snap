//- input.ts
export function main() {
	const list = {
		value: 1,
		next: { value: 2 }
	};
	const value = list.next.value;
	console.log(value, undefined);
	const fallback = value ?? -1;
	console.log(
		fallback
		/*@proven number int*/
	);
	const maybe = Math.random() > 2 ? list : undefined;
	console.log(
		maybe?.value
		/*@proven union*/
	);
}
