//- input.ts
function second(node) {
	return node?.next?.value;
}
export function main() {
	const list = {
		value: 1,
		next: { value: 2 }
	};
	const value = second(list);
	console.log(value, second(undefined));
	const fallback = value ?? -1;
	console.log(
		fallback
		/*@proven number int*/
	);
	const maybe = Math.random() > 2 ? list : undefined;
	console.log(
		maybe?.value
		/*@proven union*/
	);
}
