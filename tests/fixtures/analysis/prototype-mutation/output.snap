//- input.ts
// Replacing a method on a prototype changes what calls resolve to.
class Greeter {
	greet() {
		return "hello";
	}
}
Greeter.prototype.greet = () => 42;
export function main() {
	const greeter = new Greeter();
	// Either method may run.
	console.log(
		greeter.greet()
		/*@proven union*/
	);
}
