//- input.ts
// Interval, integer, NaN and -0 facts through arithmetic and Math.
export function main() {
	const r = Math.random();
	const unsigned = 4294967295;
	console.log(
		unsigned
		/*@proven number int nonNaN*/
	);
	const negativeZero = -0;
	console.log(
		Object.is(negativeZero, -0),
		negativeZero
		/*@proven number*/
	);
	const nan = 0 / 0;
	console.log(
		Number.isNaN(nan),
		nan
		/*@proven number*/
	);
	const rounded = Math.round(-.4);
	console.log(
		Object.is(rounded, -0),
		rounded
		/*@proven number int*/
	);
	const big = 2 ** 53 + 1;
	console.log(
		big,
		9007199254740991
		/*@proven number int*/
	);
	let i = 0;
	while (i < 10) {
		i += 3;
	}
	console.log(
		i
		/*@proven number int*/
	);
	const code = "abc".charCodeAt(5);
	console.log(code, Number.isNaN(code));
}
