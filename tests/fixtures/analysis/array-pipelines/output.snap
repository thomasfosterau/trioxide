//- input.ts
// map/filter/reduce over proven arrays: callbacks get proven elements and indices.
export function main() {
	const values = [
		1,
		2,
		3,
		4
	];
	const result = [];
	for (let i = 0, length = values.length; i < length; i++) {
		const v = values[i];
		result.push(v * 2);
	}
	const doubled = result;
	const result2 = [];
	for (let i = 0, length = doubled.length; i < length; i++) {
		const v = doubled[i];
		if (!(i % 2 === 0)) continue;
		result2.push(v);
	}
	const even = result2;
	let result3 = 0;
	for (let i = 0, length = even.length; i < length; i++) {
		const v = even[i];
		result3 = result3 + v;
	}
	const total = result3;
	console.log(
		total
		/*@proven number*/
	);
	// (Passing the arrays themselves to console.log would hand them to unknown code.)
	console.log(doubled.length, even.length);
	const words = "a b c".split(" ");
	console.log(words.join("-"), words.length);
	let found2;
	for (let i = 0, length = values.length; i < length; i++) {
		const v = values[i];
		if (v > 2) {
			found2 = v;
			break;
		}
	}
	const found = found2;
	console.log(
		found
		/*@proven union*/
	);
	for (let i = 0, length = values.length; i < length; i++) {
		if (!(i in values)) continue;
		const v = values[i];
		const all = values;
		console.log(v + i, all.length);
	}
}
