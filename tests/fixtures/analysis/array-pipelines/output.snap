//- input.ts
function forEach_callback(v, i, all) {
	console.log(v + i, all.length);
}
function find_callback(v) {
	return v > 2;
}
function reduce_callback(acc, v) {
	return acc + v;
}
function filter_callback(v, i) {
	return i % 2 === 0;
}
function map_callback(v) {
	return v * 2;
}
// map/filter/reduce over proven arrays: callbacks get proven elements and indices.
export function main() {
	const values = [
		1,
		2,
		3,
		4
	];
	const doubled = values.map(map_callback);
	const even = doubled.filter(filter_callback);
	const total = even.reduce(reduce_callback, 0);
	console.log(
		total
		/*@proven number*/
	);
	// (Passing the arrays themselves to console.log would hand them to unknown code.)
	console.log(doubled.length, even.length);
	const words = "a b c".split(" ");
	console.log(words.join("-"), words.length);
	const found = values.find(find_callback);
	console.log(
		found
		/*@proven union*/
	);
	values.forEach(forEach_callback);
}
