//- input.ts
// Hoisted `var`s are `undefined` before their assignment; functions are callable early.
export function main() {
	console.log(
		"early"
		/*@proven string*/
	);
	console.log(
		undefined
		/*@proven undefined*/
	);
	console.log(
		5
		/*@proven number int*/
	);
	let count = 0;
	const bump = () => {
		count += 1;
	};
	bump();
	console.log(
		count
		/*@proven number int*/
	);
}
