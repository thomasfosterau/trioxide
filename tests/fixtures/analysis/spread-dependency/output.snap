//- input.ts
// An object spread copies whatever the source holds by then, including properties another
// function adds after the copy is first analysed.
const source = { a: 1 };
export function main() {
	const copy = { ...source };
	console.log(
		copy.a,
		copy.b
		/*@proven union*/
	);
}
source.b = 2;
