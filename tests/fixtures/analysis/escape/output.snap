//- input.ts
// Escape facts: where allocated objects may end up.
let global;
export function main() {
	const stored = { v: 3 };
	const leaked = { v: 4 };
	console.log(3);
	global = stored;
	console.log(leaked);
	const pair = [1, 2];
	const [a, b] = pair;
	console.log(a + b, global?.v);
}
