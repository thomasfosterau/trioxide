//- input.ts
// A parent constructor calls an overridden method before the subclass's fields exist.
class Parent {
	constructor() {
		const v = this.y;
		console.log(v);
	}
	show() {}
}
class Child extends Parent {
	y = 5;
	show() {
		const v = this.y;
		console.log(v);
	}
}
// A method called from the constructor before an assignment.
class Early {
	x;
	constructor() {
		const v_1 = this.x;
		console.log(v_1);
		this.x = 1;
	}
	peek() {
		const v = this.x;
		console.log(v);
	}
}
// A static getter.
class Statics {
	static get label() {
		return "s";
	}
}
export function main() {
	new Child();
	new Early();
	const l = Statics.label;
	console.log(l);
}
