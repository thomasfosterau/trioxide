//- input.ts
// Index reads past the end give undefined, whatever TypeScript's element type says.
export function main() {
	const values = [
		1,
		2,
		3
	];
	const past = values[10];
	console.log(
		past
		/*@proven union*/
	);
	const tuple_1 = "a";
	console.log(
		tuple_1
		/*@proven union*/
	);
	console.log(
		values[5]
		/*@proven union*/
	);
}
