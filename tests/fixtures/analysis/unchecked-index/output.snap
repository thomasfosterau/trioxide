//- input.ts
// Index reads past the end give undefined, whatever TypeScript's element type says.
function at(values, index) {
	return values[5];
}
export function main() {
	const values = [
		1,
		2,
		3
	];
	const past = values[10];
	console.log(
		past
		/*@proven union*/
	);
	const tuple = [1, "a"];
	console.log(
		tuple[1]
		/*@proven union*/
	);
	console.log(
		at(values, 5)
		/*@proven union*/
	);
}
