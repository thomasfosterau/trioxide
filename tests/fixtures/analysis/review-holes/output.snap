//- input.ts
function map_callback(x) {
	return x * 2;
}
function sliced() {
	const a = new Array(3);
	a[0] = 1;
	return a.slice();
}
function found() {
	const a = [
		1,
		2,
		3
	];
	a.length = 5;
	let seen = 0;
	a.find((x) => {
		seen = x;
		return false;
	});
	return seen;
}
function idx() {
	const a = [
		1,
		2,
		3
	];
	a.length = 2;
	return a[2];
}
export function main() {
	const a = [
		1,
		2,
		3
	];
	a.length = 5;
	const m = a.map(map_callback);
	console.log(m[4], sliced()[1], found(), idx());
}
