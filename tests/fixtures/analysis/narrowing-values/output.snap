//- input.ts
// Equality and truthiness narrowing on locals.
const config = JSON.parse("null");
export function main() {
	const items = ["a", null];
	for (const item of items) {
		if (item === null) {
			console.log(
				item
				/*@proven null*/
			);
		} else {
			console.log(
				item
				/*@proven string*/
			);
		}
	}
	let count = Math.floor(Math.random() * 3);
	if (count) {
		// Truthy: not 0 (and not NaN).
		console.log(
			count
			/*@proven number int nonNaN*/
		);
	}
	if (count === 2) {
		console.log(
			count
			/*@proven number int*/
		);
	}
	count = count > 1 ? count : 1;
	const level = config?.level ?? 0;
	console.log(
		level
		/*@declared number*/
	);
	const flag = Math.random() > .5 ? "on" : undefined;
	if (flag == null) {
		console.log(
			flag
			/*@proven undefined*/
		);
	} else {
		console.log(
			flag
			/*@proven string*/
		);
	}
}
