//- input.ts
// Calls to methods of known classes resolve through the prototype chain, `super` included.
class Shape {
	area() {
		return 0;
	}
	describe() {
		return "area " + this.area();
	}
}
class Square extends Shape {
	side;
	constructor(side) {
		super();
		this.side = side;
	}
	area() {
		return this.side * this.side;
	}
}
class Circle extends Shape {
	radius;
	constructor(radius) {
		super();
		this.radius = radius;
	}
	area() {
		return Math.PI * this.radius ** 2;
	}
	describe() {
		return "circle, " + super.describe();
	}
}
function total(shapes) {
	let sum = 0;
	for (const shape of shapes) {
		sum += shape.area();
	}
	return sum;
}
export function main() {
	const square = new Square(2);
	console.log(
		square.area()
		/*@proven number int*/
	);
	const shapes = [square, new Circle(1)];
	console.log(total(shapes), shapes[1].describe());
	const area = square.area;
	// A detached method: `this` is undefined, and that's a TypeError at run time.
	try {
		area();
	} catch {
		console.log("detached");
	}
}
