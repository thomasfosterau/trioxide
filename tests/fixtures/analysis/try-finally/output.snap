//- input.ts
// Exceptions can leave a try block anywhere: a catch sees any value assigned in it.
export function main() {
	let stage = 0;
	try {
		stage = "started";
		throw new Error("too big");
	} catch {
		console.log(
			stage
			/*@proven union*/
		);
	} finally {
		console.log(
			stage
			/*@proven union*/
		);
	}
	let cleanup = false;
	try {} finally {
		cleanup = true;
	}
	console.log(
		cleanup
		/*@proven boolean*/
	);
}
