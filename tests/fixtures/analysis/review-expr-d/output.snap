//- input.ts
// A subclass accessor shadowed by the parent's own field (define semantics).
class Base {
	x = 1;
}
class Derived extends Base {
	// @ts-ignore
	get x() {
		return "getter";
	}
}
// thisArg of an iterating builtin.
function thisArg() {
	[1].forEach(function() {
		const t = this;
		console.log(t);
	}, { k: "s" });
}
// An instance made by Object.create.
class Made {
	x = 1;
	get() {
		const v = this.x;
		return v;
	}
}
export function main() {
	const d = new Derived();
	const dx = d.x;
	console.log(dx);
	const ta = new Float64Array(4);
	const buffer = ta.buffer;
	buffer.transfer();
	const e = ta[0];
	const n = ta.length;
	console.log(e, n);
	Array.prototype[1] = "hole";
	const holey = [
		1,
		,
		3
	];
	const h = holey[1];
	console.log(h);
	for (const v of holey) {
		console.log(v);
	}
	thisArg();
	const o = Object.create(Made.prototype);
	o.get();
	new Made().get();
}
