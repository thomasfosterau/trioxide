//- input.ts
// Bigints: arithmetic stays bigint; mixing with numbers throws.
function mix(a, b) {
	try {
		return a + 1;
	} catch {
		return "TypeError";
	}
}
export function main() {
	const big = 2n ** 64n;
	console.log(big, big + 1n, typeof big);
	console.log(
		mix(1n, 1)
		/*@unknown*/
	);
	console.log(
		8
		/*@proven number int*/
	);
}
