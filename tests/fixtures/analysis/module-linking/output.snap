//- input.ts
// The linker resolves imports through re-exports, star exports, defaults and namespaces.
import area, { PI_ISH as pi, double } from "./reexports.js";
import * as geometry from "./geometry.js";
import { counter } from "./geometry.js";
export function main() {
	console.log(
		pi,
		double(21)
		/*@proven number int*/
	);
	console.log(
		area(2)
		/*@proven number*/
	);
	console.log(
		geometry.perimeter(3)
		/*@proven number int*/
	);
	console.log(
		counter.count
		/*@proven number int*/
	);
}

//- reexports.ts
export { default } from "./geometry.js";
export * from "./geometry.js";
export * from "./math.js";

//- geometry.ts
export const PI_ISH = 3.14;
export function perimeter(side) {
	return side * 4;
}
export default function area(side) {
	return side * side * PI_ISH;
}
export const counter = { count: 0 };

//- math.ts
export function double(value) {
	return value * 2;
}
