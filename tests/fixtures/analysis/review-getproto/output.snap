//- input.ts
function patch() {
	const proto = Object.getPrototypeOf([]);
	proto.indexOf = () => "patched";
}
function use(a) {
	return a.indexOf(3);
}
export function main() {
	patch();
	console.log(use([
		1,
		2,
		3
	]));
}
