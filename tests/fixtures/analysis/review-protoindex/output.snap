//- input.ts
function read() {
	const a = [
		1,
		,
		3
	];
	return a[1];
}
function inbounds() {
	const a = [
		1,
		,
		3
	];
	let t = 0;
	for (let i = 0; i < 3; i++) {
		const v = a[i];
		t = v;
	}
	return t;
}
export function main() {
	const p = Object.getPrototypeOf(Object.getPrototypeOf([]));
	p[1] = "hole";
	console.log(read(), inbounds());
}
