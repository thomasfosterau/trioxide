//- input.ts
// Effect summaries: what calling a function may do, including its callees.
let state = 0;
function pure(a, b) {
	return Math.max(a, b) * 2;
}
function reader() {
	return state;
}
function writer(value) {
	state = value;
}
function thrower(value) {
	if (value < 0) {
		throw new RangeError("negative");
	}
	return Math.sqrt(value);
}
function caller() {
	writer(pure(1, 2));
	return reader();
}
function catches() {
	try {
		return thrower(-1);
	} catch {
		return 0;
	}
}
export function main() {
	console.log(pure(3, 4), caller(), catches(), 1, thrower(4));
}
