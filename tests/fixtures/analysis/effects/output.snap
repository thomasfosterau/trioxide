//- input.ts
// Effect summaries: what calling a function may do, including its callees.
let state = 0;
function thrower(value) {
	if (value < 0) {
		throw new RangeError("negative");
	}
	return Math.sqrt(value);
}
function caller() {
	const value = Math.max(1, 2) * 2;
	state = value;
	return state;
}
function catches() {
	try {
		if (-1 < 0) {
			throw new RangeError("negative");
		}
		return Math.sqrt(-1);
	} catch {
		return 0;
	}
}
export function main() {
	console.log(Math.max(3, 4) * 2, caller(), catches(), 1, thrower(4));
}
