//- input.ts
// Effect summaries: what calling a function may do, including its callees.
let state = 0;
function thrower(value) {
	if (value < 0) {
		throw new RangeError("negative");
	}
	return Math.sqrt(value);
}
function caller() {
	state = 4;
	return state;
}
function catches() {
	try {
		throw new RangeError("negative");
	} catch {
		return 0;
	}
}
export function main() {
	console.log(8, caller(), catches(), 1, thrower(4));
}
