//- input.ts
function ops(a, b, s) {
	const out = [];
	out.push(.10000000149011612);
	out.push(Infinity);
	out.push(16777216);
	out.push(a * b);
	out.push(a / b);
	out.push(a % b);
	out.push(a - b);
	out.push(a ** b);
	out.push(Math.round(a));
	out.push(Math.floor(a));
	out.push(Math.ceil(a));
	out.push(Math.trunc(a));
	out.push(Math.sign(a));
	out.push(Math.sqrt(a));
	out.push(Math.abs(a));
	out.push(Math.max(a, b));
	out.push(Math.min(a, b));
	out.push(-Infinity);
	out.push(Infinity);
	out.push(a | 0);
	out.push(a >>> 0);
	out.push(a >> b);
	out.push(a << b);
	out.push(~a);
	out.push(a & b);
	out.push(a ^ b);
	out.push(Math.round(Number(s)));
	out.push(parseInt(s));
	out.push(s.charCodeAt(5));
	out.push(Math.max(...out));
	out.push(Math.min(...[]));
	return out;
}
function inc(x) {
	let y = x;
	y++;
	return y - x;
}
export function main() {
	console.log(.10000000149011612, 34028234663852886e22, Infinity);
	const xs = [
		0,
		-0,
		.5,
		-.5,
		-.4,
		2.5,
		-2.5,
		1e300,
		-1e300,
		Infinity,
		-Infinity,
		NaN,
		2147483648,
		-2147483649,
		4294967296,
		9007199254740992,
		1e-320,
		-1e-320,
		3,
		-3,
		31,
		32
	];
	for (const a of xs) for (const b of xs) ops(a, b, "  -12.5e3 ");
	console.log(inc(9007199254740992), inc(1));
}
