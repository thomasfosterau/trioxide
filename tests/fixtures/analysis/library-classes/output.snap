//- input.ts
// world: library
// Library mode: exported classes may be constructed and extended by unknown code.
export class Account {
	balance = 0;
	deposit(amount) {
		this.balance += amount;
		return this.balance;
	}
}
class Internal {
	value = 1;
	get() {
		return this.value;
	}
}
export function main() {
	const account = new Account();
	console.log(account.deposit(10), new Internal().get());
}
