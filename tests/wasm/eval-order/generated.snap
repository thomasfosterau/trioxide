//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn addSelfInc(a: f64) -> f64 {
    let mut y = a;
    y = y
        + ({
            let old = y;
            y += 1.0;
            old
        });
    y
}

fn plusSelfInc(a: f64) -> f64 {
    let mut y = a;
    y = y
        + ({
            let old = y;
            y += 1.0;
            old
        });
    y
}

fn mulAssignInc(a: f64) -> f64 {
    let mut y = a;
    y = y
        * (({
            let old = y;
            y += 1.0;
            old
        }) + 1.0);
    y
}

fn storeIndexThenInc(xs: &mut [f64]) -> i32 {
    let mut i: i32 = 0;
    let index: i32 = i;
    let value = f64::from(
        ({
            let old: i32 = i;
            i += 1;
            old
        }) + 10,
    );
    array::set_i32(xs, index, value);
    i
}

fn compoundIndexThenInc(xs: &mut [f64]) -> i32 {
    let mut i: i32 = 0;
    let index: i32 = i;
    let value = array::get_i32(xs, index)
        + f64::from(
            ({
                let old: i32 = i;
                i += 1;
                old
            }) + 10,
        );
    array::set_i32(xs, index, value);
    i
}

fn incIndexThenRead(xs: &mut [f64]) -> i32 {
    let mut i: i32 = 0;
    array::set_i32(
        xs,
        {
            let old: i32 = i;
            i += 1;
            old
        },
        f64::from(i + 20),
    );
    i
}

fn storeCallIndex(xs: &mut [f64], log: &mut [f64]) {
    let index: i32 = bump(log, 1);
    let value = f64::from(bump(log, 2));
    array::set_i32(xs, index, value);
}

fn compoundCallIndex(xs: &mut [f64], log: &mut [f64]) {
    let index: i32 = bump(log, 1);
    let value = array::get_i32(xs, index) + f64::from(bump(log, 2));
    array::set_i32(xs, index, value);
}

fn callArgs(log: &mut [f64]) -> i32 {
    let mut k: i32 = 1;
    pair(
        k,
        {
            let old: i32 = k;
            k += 1;
            old
        },
    )
        + pair(
            {
                let old_2: i32 = k;
                k += 1;
                old_2
            },
            k,
        ) * 100 + bump(log, 3) * 0
}

fn bump(log: &mut [f64], v: i32) -> i32 {
    array::set_i32(log, 0, array::get_i32(log, 0) * 100.0 + f64::from(v));
    v
}

fn pair(a: i32, b: i32) -> i32 {
    a * 10 + b
}

