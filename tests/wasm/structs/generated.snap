//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

/// `Particle`, a plain-data object parameter (`structs[0]` in the spec).
#[repr(C)]
#[derive(Clone, Copy)]
pub struct Particle {
    pub x: f64,
    pub y: f64,
    pub vx: f64,
    pub vy: f64,
    pub alive: bool,
}

const _: () = {
    assert!(size_of::<Particle>() == 40 && align_of::<Particle>() == 8);
    assert!(core::mem::offset_of!(Particle, y) == 8);
    assert!(core::mem::offset_of!(Particle, vx) == 16);
    assert!(core::mem::offset_of!(Particle, vy) == 24);
    assert!(core::mem::offset_of!(Particle, alive) == 32);
};

/// `{ lo, hi, spread }`, the object literal `bounds` returns (`structs[1]` in the spec).
#[repr(C)]
#[derive(Clone, Copy)]
pub struct Bounds {
    pub lo: f64,
    pub hi: f64,
    pub spread: f64,
}

const _: () = {
    assert!(size_of::<Bounds>() == 24 && align_of::<Bounds>() == 8);
    assert!(core::mem::offset_of!(Bounds, hi) == 8);
    assert!(core::mem::offset_of!(Bounds, spread) == 16);
};

/// `{ x, y }`, the object literal `sum` returns (`structs[2]` in the spec).
#[repr(C)]
#[derive(Clone, Copy)]
pub struct Sum {
    pub x: f64,
    pub y: f64,
}

const _: () = {
    assert!(size_of::<Sum>() == 16 && align_of::<Sum>() == 8);
    assert!(core::mem::offset_of!(Sum, y) == 8);
};

/// The class `Vec`, used only inside the island.
#[derive(Clone, Copy)]
struct Vec {
    x: f64,
    y: f64,
}

impl Vec {
    fn new(x: f64, y: f64) -> Self {
        Vec { x, y }
    }

    fn dot(self, other: Vec) -> f64 {
        self.x * other.x + self.y * other.y
    }

    fn plus(self, other: Vec) -> Vec {
        Vec::new(self.x + other.x, self.y + other.y)
    }
}

fn r#move(p: &mut Particle, dt: f64) {
    if !p.alive {
        return;
    }
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    if p.x * p.x + p.y * p.y > 100.0 {
        p.alive = false;
    }
}

fn speed(p: &Particle) -> f64 {
    let v = Vec::new(p.vx, p.vy);
    math::sqrt(v.dot(v))
}

fn bounds(xs: &[f64]) -> Bounds {
    let mut lo = f64::INFINITY;
    let mut hi = f64::NEG_INFINITY;
    for index in 0..xs.len() {
        // SAFETY: the loop keeps the index below the length.
        let x = unsafe { array::get_unchecked(xs, index) };
        lo = math::min(lo, x);
        hi = math::max(hi, x);
    }
    Bounds { lo, hi, spread: hi - lo }
}

fn sum(xs: &[f64], ys: &[f64]) -> Sum {
    let mut acc = Vec::new(0.0, 0.0);
    let mut i = 0.0;
    while i < array::len(xs) {
        // SAFETY: the analysis proves the index is in bounds.
        acc = acc
            .plus(
                Vec::new(
                    unsafe { array::get_unchecked(xs, i as usize) },
                    array::get(ys, i),
                ),
            );
        i += 1.0;
    }
    Sum { x: acc.x, y: acc.y }
}

#[unsafe(export_name = "move")]
pub unsafe extern "C" fn __abi_move(p_ptr: u32, dt: f64) {
    // SAFETY: the glue passes fresh copies.
    let p = unsafe { abi::struct_mut::<Particle>(p_ptr) };
    r#move(p, dt);
}

#[unsafe(export_name = "speed")]
pub unsafe extern "C" fn __abi_speed(p_ptr: u32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let p = unsafe { abi::struct_ref::<Particle>(p_ptr) };
    speed(p)
}

#[unsafe(export_name = "bounds")]
pub unsafe extern "C" fn __abi_bounds(xs_ptr: u32, xs_len: u32) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice::<f64>(xs_ptr, xs_len) };
    abi::return_struct(bounds(xs))
}

#[unsafe(export_name = "sum")]
pub unsafe extern "C" fn __abi_sum(
    xs_ptr: u32,
    xs_len: u32,
    ys_ptr: u32,
    ys_len: u32,
) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice::<f64>(xs_ptr, xs_len) };
    let ys = unsafe { abi::slice::<f64>(ys_ptr, ys_len) };
    abi::return_struct(sum(xs, ys))
}
