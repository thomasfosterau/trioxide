//- kernel/src/lib.rs
//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn all(x: f64, y: f64) -> &'static mut [f64] {
    let out = abi::alloc_array::<f64>(20);
    array::set_i32(out, 0, math::abs(x));
    array::set_i32(out, 1, math::floor(x));
    array::set_i32(out, 2, math::ceil(x));
    array::set_i32(out, 3, math::trunc(x));
    array::set_i32(out, 4, math::sqrt(x));
    array::set_i32(out, 5, math::round(x));
    array::set_i32(out, 6, math::sign(x));
    array::set_i32(out, 7, math::fround(x));
    array::set_i32(out, 8, f64::from(math::clz32(x) as i32));
    array::set_i32(out, 9, f64::from(math::imul(x, y)));
    array::set_i32(out, 10, math::max(math::max(x, y), 0.0));
    array::set_i32(out, 11, math::min(x, y));
    array::set_i32(out, 12, math::hypot2(x, y));
    array::set_i32(out, 13, math::atan(y) + math::asin(x / 1e300) + math::acos(0.5));
    array::set_i32(out, 14, math::tan(x));
    array::set_i32(out, 15, math::log2(x));
    array::set_i32(out, 16, math::expm1(x));
    array::set_i32(out, 17, x * x);
    array::set_i32(out, 18, y);
    array::set_i32(out, 19, 3.141592653589793 * x + f64::NEG_INFINITY + y);
    out
}

#[unsafe(export_name = "all")]
pub extern "C" fn __abi_all(x: f64, y: f64) -> u32 {
    abi::return_array(all(x, y))
}
