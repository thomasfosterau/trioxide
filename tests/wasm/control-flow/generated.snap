//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn firstAbove(xs: &[f64], limit: i32) -> i32 {
    let mut i = 0.0;
    while i < array::len(xs) {
        // SAFETY: the analysis proves the index is in bounds.
        if (unsafe { array::get_unchecked(xs, i as usize) }) > f64::from(limit) {
            return i as i32;
        }
        i += 1.0;
    }
    -1
}

fn skipNegatives(xs: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(xs) {
        'c0: {
            // SAFETY: the analysis proves the index is in bounds.
            if (unsafe { array::get_unchecked(xs, i as usize) }) < 0.0 {
                break 'c0;
            }
            // SAFETY: the analysis proves the index is in bounds.
            total += unsafe { array::get_unchecked(xs, i as usize) };
        }
        i += 1.0;
    }
    total
}

fn findPair(xs: &[i32], target: i32) -> i32 {
    let mut found = -1.0;
    let mut i = 0.0;
    'l0: while i < array::len(xs) {
        'c0: {
            let mut j = i + 1.0;
            while j < array::len(xs) {
                // SAFETY: the analysis proves the index is in bounds.
                if f64::from((unsafe { array::get_unchecked(xs, i as usize) }) as i32)
                    + f64::from((unsafe { array::get_unchecked(xs, j as usize) }) as i32)
                    == f64::from(target)
                {
                    found = i * 1000.0 + j;
                    break 'l0;
                }
                // SAFETY: the analysis proves the index is in bounds.
                if (unsafe { array::get_unchecked(xs, j as usize) }) as i32 > target {
                    break 'c0;
                }
                j += 1.0;
            }
        }
        i += 1.0;
    }
    found as i32
}

fn collatz(n: f64) -> f64 {
    let mut steps = 0.0;
    let mut x = n;
    loop {
        if x <= 1.0 {
            break;
        }
        x = if ops::rem(x, 2.0) == 0.0 { x / 2.0 } else { 3.0 * x + 1.0 };
        steps += 1.0;
        if !(steps < 1000.0) {
            break;
        }
    }
    steps
}

fn countdown(n: f64) -> f64 {
    let mut total = 0.0;
    let mut i = n;
    loop {
        i -= 1.0;
        if i < 0.0 {
            break;
        }
        if ops::rem(i, 3.0) == 0.0 {
            continue;
        }
        total += i;
    }
    total
}

fn sumOf(values: &[f64]) -> f64 {
    let mut total = 0.0;
    for index in 0..values.len() {
        // SAFETY: the loop keeps the index below the length.
        let v = unsafe { array::get_unchecked(values, index) };
        if v > 100.0 {
            break;
        }
        total += v;
    }
    total
}

fn jumps(limit: f64) -> f64 {
    let mut total = 0.0;
    let mut m = 0.0;
    'l0: loop {
        'c0: {
            m += 1.0;
            if m == 2.0 {
                break 'c0;
            }
            if total > limit {
                break 'l0;
            }
            total += m;
        }
        if !(m < 10.0) {
            break;
        }
    }
    let mut i: i32 = 0;
    'l1: while i < 8 {
        'c1: {
            if ops::rem_i32(i, 3) == 0.0 {
                break 'c1;
            }
            'l2: {
                if f64::from(i) > limit {
                    break 'l2;
                }
                if i == 7 {
                    break 'l1;
                }
                total += f64::from(i * 10);
            }
        }
        i += 1;
    }
    total
}

fn pick(xs: &[f64], k: i32) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(xs) {
        // SAFETY: the analysis proves the index is in bounds.
        total
            += if f64::from(k) > i {
                1.0
            } else {
                (unsafe { array::get_unchecked(xs, i as usize) }) + 0.5
            };
        i += 1.0;
    }
    total
}

#[unsafe(export_name = "firstAbove")]
pub unsafe extern "C" fn __abi_firstAbove(xs_ptr: u32, xs_len: u32, limit: i32) -> i32 {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice::<f64>(xs_ptr, xs_len) };
    firstAbove(xs, limit)
}

#[unsafe(export_name = "skipNegatives")]
pub unsafe extern "C" fn __abi_skipNegatives(xs_ptr: u32, xs_len: u32) -> f64 {
    // SAFETY: the glue passes fresh copies.
