//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn fib(n: i32) -> f64 {
    if n < 2 { f64::from(n) } else { fib(n - 1) + fib(n - 2) }
}

fn gcd(a: f64, b: f64) -> f64 {
    if b == 0.0 { a } else { gcd(b, ops::rem(a, b)) }
}

fn isEven(n: f64) -> bool {
    if n == 0.0 { true } else { isOdd(n - 1.0) }
}

fn isOdd(n: f64) -> bool {
    if n == 0.0 { false } else { isEven(n - 1.0) }
}

fn power(base: f64, exponent: f64) -> f64 {
    if exponent <= 0.0 {
        return 1.0;
    }
    let half = power(base, math::floor(exponent / 2.0));
    if ops::rem(exponent, 2.0) == 0.0 { half * half } else { half * half * base }
}

#[unsafe(export_name = "fib")]
pub extern "C" fn __abi_fib(n: i32) -> f64 {
    fib(n)
}

#[unsafe(export_name = "gcd")]
pub extern "C" fn __abi_gcd(a: f64, b: f64) -> f64 {
    gcd(a, b)
}

#[unsafe(export_name = "isEven")]
pub extern "C" fn __abi_isEven(n: f64) -> i32 {
    i32::from(isEven(n))
}

#[unsafe(export_name = "isOdd")]
pub extern "C" fn __abi_isOdd(n: f64) -> i32 {
    i32::from(isOdd(n))
}

#[unsafe(export_name = "power")]
pub extern "C" fn __abi_power(base: f64, exponent: f64) -> f64 {
    power(base, exponent)
}
