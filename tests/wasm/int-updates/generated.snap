//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn bumpI8(xs: &mut [i8], i: f64) {
    array::add(xs, i, 1);
}

fn bumpU8(xs: &mut [u8], i: f64) {
    array::add(xs, i, 1);
}

fn bumpC8(xs: &mut [U8Clamped], i: f64) {
    array::add(xs, i, 1);
}

fn bumpI16(xs: &mut [i16], i: f64) {
    array::add(xs, i, -1);
}

fn bumpU16(xs: &mut [u16], i: f64) {
    array::add(xs, i, -1);
}

fn bumpI32(xs: &mut [i32], i: f64) {
    array::add(xs, i, 7);
}

fn bumpU32(xs: &mut [u32], i: f64) {
    array::add(xs, i, -3);
}

fn bumpF32(xs: &mut [f32], i: f64) {
    array::add(xs, i, 1);
}

fn bumpF64(xs: &mut [f64], i: f64) {
    array::add(xs, i, -1);
}

fn addAll(xs: &mut [u32], k: f64) {
    let d: i32 = conv::to_int32(k);
    let mut i = 0.0;
    while i < array::len(xs) {
        array::add(xs, i, d);
        array::set(xs, i, array::get(xs, i) - f64::from(ops::shr_i32(d, 1)));
        i += 1.0;
    }
}

fn histogram(bytes: &[u8], bins: &mut [u32]) {
    let mut i: i32 = 0;
    while i < bytes.len() as i32 {
        // SAFETY: the analysis proves the index is in bounds.
        let index: i32 = ops::shr_i32(
            (unsafe { array::get_unchecked(bytes, i as usize) }) as i32,
            4,
        );
        array::add_i32(bins, index, 1);
        i += 1;
    }
}

fn overwrite(xs: &mut [i32], i: i32) -> i32 {
    array::set_i32(xs, i, 100.0);
    1
}

fn addAfterWrite(xs: &mut [i32], i: i32) {
    let value = array::get_i32(xs, i) + f64::from(overwrite(xs, i));
    array::set_i32(xs, i, value);
}

fn readInts(xs: &[f64], ys: &[u32], zs: &[i8], i: f64) -> f64 {
    f64::from(array::get_int32(xs, i) ^ array::get_int32(ys, i))
        + f64::from(ops::shr_i32(array::get_int32(zs, i), 1))
        + f64::from(array::get_int32(xs, i + 100.0))
        + f64::from(array::get_int32_i32(ys, -1) & 255)
}

fn hash(seed: f64, rounds: i32) -> u32 {
    let mut h = f64::from(conv::to_int32(seed));
    let mut r: i32 = 0;
    while r < rounds {
        h = f64::from(conv::to_int32(h) ^ ops::shl_i32(conv::to_int32(h), 13));
        h = f64::from(math::imul_i32(conv::to_int32(h), 2654435761_u32 as i32));
        h = f64::from(math::imul_i32(conv::to_int32(h) ^ 5, -2))
            + f64::from(math::imul_i32(1410065408, conv::to_int32(h)));
        h = f64::from(
            conv::to_int32(h) & 4294967295_u32 as i32 ^ (conv::to_int32(h) | 0)
                ^ ops::ushr_i32(conv::to_int32(h), 32) as i32,
        );
        r += 1;
    }
    conv::to_uint32(h)
}

