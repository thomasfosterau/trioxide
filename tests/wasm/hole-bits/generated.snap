fn mul1(xs: &mut [f64]) {
    let mut i: u32 = 0_i32 as u32;
    while f64::from(i) < array::len(xs) {
        array::set(
            xs,
            f64::from(i),
            array::store_number(array::get(xs, f64::from(i)) * 1.0),
        );
        i = i.wrapping_add(1_i32 as u32);
    }
}

