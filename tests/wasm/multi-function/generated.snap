//- kernel/src/lib.rs
//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

const STEPS: f64 = 8.0;

fn curve(a: f64, b: i32, out: &mut [f64]) {
    let mut i = 0.0;
    while i < array::len(out) {
        let value = sample(a, b, i);
        array::set(out, i, value);
        i += 1.0;
    }
}

fn area(a: f64, b: i32) -> f64 {
    let out = abi::alloc_array::<f64>((STEPS + 1.0) as usize);
    curve(a, b, out);
    let mut total = 0.0;
    let mut i: i32 = 0;
    while i < out.len() as i32 {
        // SAFETY: the analysis proves the index is in bounds.
        total += unsafe { array::get_unchecked(out, i as usize) };
        i += 1;
    }
    total / core::hint::black_box(array::len(out))
}

fn sample(a: f64, b: i32, i: f64) -> f64 {
    lerp(a, b, smooth(i / core::hint::black_box(STEPS)))
}

fn lerp(a: f64, b: i32, t: f64) -> f64 {
    a + (f64::from(b) - a) * t
}

fn smooth(t: f64) -> f64 {
    t * t * (3.0 - 2.0 * t)
}

#[unsafe(export_name = "curve")]
pub unsafe extern "C" fn __abi_curve(a: f64, b: i32, out_ptr: u32, out_len: u32) {
    // SAFETY: the glue passes fresh copies.
    let out = unsafe { abi::slice_mut::<f64>(out_ptr, out_len) };
    curve(a, b, out);
}

#[unsafe(export_name = "area")]
pub extern "C" fn __abi_area(a: f64, b: i32) -> f64 {
    area(a, b)
}
