//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.
#![no_std]
#![allow(non_snake_case, clippy::all)]
use trioxide_rt::prelude::*;
fn rem(a: f64, b: f64) -> f64 {
    ops::rem(a, b)
}
fn irem(a: f64, b: f64) -> f64 {
    ops::rem_i32(conv::to_int32(a), conv::to_int32(b))
}
fn isEven(x: f64) -> bool {
    ops::rem_i32(conv::to_int32(x), 2) == 0.0
}
fn wrapIndex(i: i32, n: i32) -> f64 {
    ops::rem(ops::rem_i32(i, n) + f64::from(n), f64::from(n))
}
#[unsafe(export_name = "rem")]
pub extern "C" fn __abi_rem(a: f64, b: f64) -> f64 {
    rem(a, b)
}
#[unsafe(export_name = "irem")]
pub extern "C" fn __abi_irem(a: f64, b: f64) -> f64 {
    irem(a, b)
}
#[unsafe(export_name = "isEven")]
pub extern "C" fn __abi_isEven(x: f64) -> i32 {
    i32::from(isEven(x))
}
#[unsafe(export_name = "wrapIndex")]
pub extern "C" fn __abi_wrapIndex(i: i32, n: i32) -> f64 {
    wrapIndex(i, n)
}
