#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn memory(x: i32) -> i32 {
    x + 1
}

fn __trioxide_alloc(x: i32) -> i32 {
    x * 2
}

fn x_1(x: i32) -> i32 {
    x - 1
}

fn x_1_2(x: i32) -> i32 {
    x * 10
}

