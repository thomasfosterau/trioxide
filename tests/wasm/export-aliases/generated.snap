//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn sq(x: i32) -> i32 {
    x * x
}

fn cube(x: i32) -> i32 {
    x * x * x
}

fn tw(x: i32) -> i32 {
    x + 1
}

#[unsafe(export_name = "sq")]
pub extern "C" fn __abi_sq(x: i32) -> i32 {
    sq(x)
}

#[unsafe(export_name = "cube")]
pub extern "C" fn __abi_cube(x: i32) -> i32 {
    cube(x)
}

#[unsafe(export_name = "tw")]
pub extern "C" fn __abi_tw(x: i32) -> i32 {
    tw(x)
}
