//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.
#![no_std]
#![allow(non_snake_case, clippy::all)]
use trioxide_rt::prelude::*;
fn and(a: f64, b: f64) -> i32 {
    conv::to_int32(a) & conv::to_int32(b)
}
fn or(a: f64, b: f64) -> i32 {
    conv::to_int32(a) | conv::to_int32(b)
}
fn xor(a: f64, b: f64) -> i32 {
    conv::to_int32(a) ^ conv::to_int32(b)
}
fn not(a: f64) -> i32 {
    !conv::to_int32(a)
}
fn shl(a: f64, b: f64) -> i32 {
    ops::shl_i32(conv::to_int32(a), conv::to_int32(b))
}
fn shr(a: f64, b: f64) -> i32 {
    ops::shr_i32(conv::to_int32(a), conv::to_int32(b))
}
fn ushr(a: f64, b: f64) -> u32 {
    ops::ushr_i32(conv::to_int32(a), conv::to_int32(b))
}
fn toInt(a: f64) -> i32 {
    conv::to_int32(a)
}
fn toUint(a: f64) -> u32 {
    conv::to_uint32(a)
}
fn idiv(a: f64, b: f64) -> i32 {
    ops::div_trunc_i32(conv::to_int32(a), conv::to_int32(b))
}
fn wrapSum(a: f64, b: f64) -> i32 {
    i32::wrapping_add(conv::to_int32(a), conv::to_int32(b))
}
fn wrapDiff(a: f64, b: f64) -> i32 {
    i32::wrapping_sub(conv::to_int32(a), conv::to_int32(b))
}
fn lowestBit(x: f64) -> i32 {
    let v: i32 = conv::to_int32(x);
    v & conv::to_int32(-f64::from(v))
}
fn rotate(x: f64, n: f64) -> i32 {
    let v: i32 = conv::to_int32(x);
    let k: i32 = conv::to_int32(n) & 31;
    ops::shl_i32(v, k) | ops::ushr_i32(v, i32::wrapping_sub(32, k)) as i32
}
