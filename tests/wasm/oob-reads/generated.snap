//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.
#![no_std]
#![allow(non_snake_case, clippy::all)]
use trioxide_rt::prelude::*;
fn sumPairs(xs: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(xs) {
        // SAFETY: the analysis proves the index is in bounds.
        total
            += unsafe { array::get_unchecked(xs, i as usize) } * array::get(xs, i + 1.0);
        i += 2.0;
    }
    total
}
fn at(xs: &[i32], i: f64) -> f64 {
    array::get(xs, i) + 0.0
}
fn isSmall(xs: &[f64], i: i32) -> bool {
    array::get_i32(xs, i) < 1.0
}
fn isZero(xs: &[f64], i: i32) -> bool {
    array::get_i32(xs, i) == 0.0
}
fn present(xs: &[u8], i: i32) -> i32 {
    if conv::to_boolean(array::get_i32(xs, i)) { 1 } else { 0 }
}
fn dot(a: &[f64], b: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(a) {
        total += array::get(a, i) * array::get(b, i);
        i += 1.0;
    }
    total
}
fn writeAll(xs: &mut [i16], from: i32, count: i32) {
    let mut i = 0.0;
    while i < f64::from(count) {
        array::set(xs, f64::from(from) + i, 1000.0 * i);
        i += 1.0;
    }
}
