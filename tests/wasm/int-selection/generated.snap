//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn triangle(n: f64) -> f64 {
    let mut sum = 0.0;
    let mut i = 0.0;
    while i < n {
        sum += i;
        i += 1.0;
    }
    sum
}

fn countBits(x: f64) -> f64 {
    let mut count = 0.0;
    let mut bit: i32 = 0;
    while bit < 32 {
        if ops::ushr_i32(conv::to_int32(x), bit) as i32 & 1 != 0 {
            count += 1.0;
        }
        bit += 1;
    }
    count
}

fn sumBytes(bytes: &[u8]) -> f64 {
    let mut total = 0.0;
    let mut i: i32 = 0;
    while i < bytes.len() as i32 {
        // SAFETY: the analysis proves the index is in bounds.
        total += f64::from((unsafe { array::get_unchecked(bytes, i as usize) }) as i32);
        i += 1;
    }
    total
}

fn square(x: f64) -> f64 {
    let y: i32 = conv::to_int32(x);
    f64::from(y) * f64::from(y)
}

fn hashPair(a: f64, b: f64) -> u32 {
    (conv::to_int32(a * 31.0) ^ conv::to_int32(b)) as u32
}

fn negate(x: f64) -> f64 {
    let y: i32 = conv::to_int32(x);
    -f64::from(y)
}

#[unsafe(export_name = "triangle")]
pub extern "C" fn __abi_triangle(n: f64) -> f64 {
    triangle(n)
}

#[unsafe(export_name = "countBits")]
pub extern "C" fn __abi_countBits(x: f64) -> f64 {
    countBits(x)
}

#[unsafe(export_name = "sumBytes")]
pub unsafe extern "C" fn __abi_sumBytes(bytes_ptr: u32, bytes_len: u32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let bytes = unsafe { abi::slice::<u8>(bytes_ptr, bytes_len) };
    sumBytes(bytes)
}

#[unsafe(export_name = "square")]
pub extern "C" fn __abi_square(x: f64) -> f64 {
    square(x)
}

#[unsafe(export_name = "hashPair")]
pub extern "C" fn __abi_hashPair(a: f64, b: f64) -> u32 {
    hashPair(a, b)
}

#[unsafe(export_name = "negate")]
pub extern "C" fn __abi_negate(x: f64) -> f64 {
    negate(x)
}
