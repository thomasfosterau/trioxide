//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn fillThenFail(dst: &mut [f64], n: f64) -> f64 {
    array::set_i32(dst, 0, 1.0);
    let scratch = abi::new_array::<f64>(n);
    array::set_i32(dst, 1, 2.0);
    array::len(scratch)
}

fn sum(xs: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(xs) {
        total += array::get(xs, i);
        i += 1.0;
    }
    total
}

fn bump(xs: &mut [f64]) {
    let mut i = 0.0;
    while i < array::len(xs) {
        array::set(xs, i, array::get(xs, i) + 1.0);
        i += 1.0;
    }
}

fn touch(xs: &mut [f64]) {
    let mut i = 0.0;
    while i < array::len(xs) {
        if ops::rem(i, 4.0) == 1.0 {
            array::set(xs, i, f64::NAN);
        } else if ops::rem(i, 4.0) == 2.0 {
            array::set(xs, i, array::get(xs, i) + 0.0);
        } else if ops::rem(i, 4.0) == 3.0 {
            array::set(xs, i, array::store_number(array::get(xs, i)));
        }
        i += 1.0;
    }
}

#[unsafe(export_name = "fillThenFail")]
pub unsafe extern "C" fn __abi_fillThenFail(dst_ptr: u32, dst_len: u32, n: f64) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let dst = unsafe { abi::slice_mut::<f64>(dst_ptr, dst_len) };
    fillThenFail(dst, n)
}

#[unsafe(export_name = "sum")]
pub unsafe extern "C" fn __abi_sum(xs_ptr: u32, xs_len: u32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice::<f64>(xs_ptr, xs_len) };
    sum(xs)
}

#[unsafe(export_name = "bump")]
pub unsafe extern "C" fn __abi_bump(xs_ptr: u32, xs_len: u32) {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice_mut::<f64>(xs_ptr, xs_len) };
    bump(xs);
}

#[unsafe(export_name = "touch")]
pub unsafe extern "C" fn __abi_touch(xs_ptr: u32, xs_len: u32) {
    // SAFETY: the glue passes fresh copies.
    let xs = unsafe { abi::slice_mut::<f64>(xs_ptr, xs_len) };
