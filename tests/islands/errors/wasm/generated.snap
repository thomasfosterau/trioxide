//- kernel/src/lib.rs
//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn filled(length: f64, value: f64) -> &'static mut [f64] {
    let out = abi::new_array::<f64>(length);
    let mut i = 0.0;
    while i < array::len(out) {
        array::set(out, i, value);
        i += 1.0;
    }
    out
}

fn total(length: f64) -> f64 {
    let scratch = abi::new_array::<f64>(length);
    let mut sum = 0.0;
    let mut i = 0.0;
    while i < array::len(scratch) {
        array::set(scratch, i, i);
        // SAFETY: the analysis proves the index is in bounds.
        sum += unsafe { array::get_unchecked(scratch, i as usize) };
        i += 1.0;
    }
    sum
}

#[unsafe(export_name = "filled")]
pub extern "C" fn __abi_filled(length: f64, value: f64) -> u32 {
    abi::return_array(filled(length, value))
}

#[unsafe(export_name = "total")]
pub extern "C" fn __abi_total(length: f64) -> f64 {
    total(length)
}
