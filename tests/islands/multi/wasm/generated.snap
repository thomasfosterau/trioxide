//- kernel/src/lib.rs
//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn identity(n: i32) -> &'static mut [f64] {
    let m = abi::alloc_array::<f64>((n * n) as usize);
    let mut i: i32 = 0;
    while i < n {
        array::set(m, at(f64::from(n), i, f64::from(i)), 1.0);
        i += 1;
    }
    m
}

fn multiply(a: &[f64], b: &[f64], n: f64) -> &'static mut [f64] {
    let out = abi::new_array::<f64>(n * n);
    let mut i: i32 = 0;
    while f64::from(i) < n {
        let mut j: i32 = 0;
        while f64::from(j) < n {
            let mut s = 0.0;
            let mut k: i32 = 0;
            while f64::from(k) < n {
                s
                    += array::get(a, at(n, i, f64::from(k)))
                        * array::get(b, at(n, k, f64::from(j)));
                k += 1;
            }
            array::set(out, at(n, i, f64::from(j)), s);
            j += 1;
        }
        i += 1;
    }
    out
}

fn power(m: &[f64], n: i32, mut k: i32) -> &'static mut [f64] {
    let mut result = identity(n);
    let mut base: &[f64] = m;
    while k > 0 {
        if ops::rem_i32(k, 2) == 1.0 {
            result = multiply(result, base, f64::from(n));
        }
        base = multiply(base, base, f64::from(n));
        k = math::floor(f64::from(k) / 2.0) as i32;
    }
    result
}

fn trace(m: &[f64], n: i32) -> f64 {
    let mut t = 0.0;
    let mut i: i32 = 0;
    while i < n {
        t += array::get(m, at(f64::from(n), i, f64::from(i)));
        i += 1;
    }
    t
}

fn determinant(m: &[f64], n: i32) -> f64 {
    let a = abi::alloc_array::<f64>(m.len());
    let mut i: i32 = 0;
    while i < m.len() as i32 {
        // SAFETY: the analysis proves the index is in bounds.
        array::set_i32(a, i, unsafe { array::get_unchecked(m, i as usize) });
        i += 1;
    }
    let mut det = 1.0;
    let mut col: i32 = 0;
    while col < n {
        let mut pivot: i32 = col;
        let mut row: i32 = col + 1;
        while row < n {
            if math::abs(array::get(a, at(f64::from(n), row, f64::from(col))))
                > math::abs(array::get(a, at(f64::from(n), pivot, f64::from(col))))
            {
                pivot = row;
            }
            row += 1;
        }
        if array::get(a, at(f64::from(n), pivot, f64::from(col))) == 0.0 {
            return 0.0;
        }
        if pivot != col {
            swapRows(a, n, pivot, col);
            det = -det;
        }
        det *= array::get(a, at(f64::from(n), col, f64::from(col)));
        let mut row_2: i32 = col + 1;
        while row_2 < n {
            let f = array::get(a, at(f64::from(n), row_2, f64::from(col)))
                / core::hint::black_box(
                    array::get(a, at(f64::from(n), col, f64::from(col))),
                );
            let mut k: i32 = col;
            while k < n {
                let index = at(f64::from(n), row_2, f64::from(k));
                let value = array::get(a, index)
                    - f * array::get(a, at(f64::from(n), col, f64::from(k)));
                array::set(a, index, value);
                k += 1;
            }
            row_2 += 1;
        }
        col += 1;
    }
    det
}

fn axpy(y: &mut [f64], x: &[f64], alpha: i32) {
    let mut i = 0.0;
    while i < array::len(y) {
        array::set(y, i, array::get(y, i) + f64::from(alpha) * array::get(x, i));
        i += 1.0;
    }
}

fn at(n: f64, row: i32, col: f64) -> f64 {
    f64::from(row) * n + col
}

fn swapRows(a: &mut [f64], n: i32, r1: i32, r2: i32) {
    let mut k = 0.0;
    while k < f64::from(n) {
        let t = array::get(a, at(f64::from(n), r1, k));
        let index = at(f64::from(n), r1, k);
        let value = array::get(a, at(f64::from(n), r2, k));
        array::set(a, index, value);
        array::set(a, at(f64::from(n), r2, k), t);
        k += 1.0;
    }
}

#[unsafe(export_name = "identity")]
pub extern "C" fn __abi_identity(n: i32) -> u32 {
    abi::return_array(identity(n))
}

#[unsafe(export_name = "multiply")]
pub unsafe extern "C" fn __abi_multiply(
    a_ptr: u32,
    a_len: u32,
    b_ptr: u32,
    b_len: u32,
    n: f64,
) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let a = unsafe { abi::slice::<f64>(a_ptr, a_len) };
    let b = unsafe { abi::slice::<f64>(b_ptr, b_len) };
    abi::return_array(multiply(a, b, n))
}

#[unsafe(export_name = "power")]
pub unsafe extern "C" fn __abi_power(m_ptr: u32, m_len: u32, n: i32, k: i32) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let m = unsafe { abi::slice::<f64>(m_ptr, m_len) };
    abi::return_array(power(m, n, k))
}

#[unsafe(export_name = "trace")]
pub unsafe extern "C" fn __abi_trace(m_ptr: u32, m_len: u32, n: i32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let m = unsafe { abi::slice::<f64>(m_ptr, m_len) };
    trace(m, n)
}

#[unsafe(export_name = "determinant")]
pub unsafe extern "C" fn __abi_determinant(m_ptr: u32, m_len: u32, n: i32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let m = unsafe { abi::slice::<f64>(m_ptr, m_len) };
    determinant(m, n)
}

#[unsafe(export_name = "axpy")]
pub unsafe extern "C" fn __abi_axpy(
    y_ptr: u32,
    y_len: u32,
    x_ptr: u32,
    x_len: u32,
    alpha: i32,
) {
    // SAFETY: the glue passes fresh copies and checks they don't overlap.
    let y = unsafe { abi::slice_mut::<f64>(y_ptr, y_len) };
    let x = unsafe { abi::slice::<f64>(x_ptr, x_len) };
    axpy(y, x, alpha);
}
