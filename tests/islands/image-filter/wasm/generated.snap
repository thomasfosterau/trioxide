//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn brighten(pixels: &mut [U8Clamped], factor: f64) {
    let mut i = 0.0;
    while i < array::len(pixels) {
        if conv::to_int32(i) & 3 != 3 {
            array::set(pixels, i, array::get(pixels, i) * factor);
        }
        i += 1.0;
    }
}

fn grayscale(pixels: &mut [U8Clamped]) {
    let mut i = 0.0;
    while i + 3.0 < array::len(pixels) {
        let luma = 0.299 * array::get(pixels, i) + 0.587 * array::get(pixels, i + 1.0)
            + 0.114 * array::get(pixels, i + 2.0);
        array::set(pixels, i, luma);
        array::set(pixels, i + 1.0, luma);
        array::set(pixels, i + 2.0, luma);
        i += 4.0;
    }
}

fn boxBlur(src: &[U8Clamped], width: f64, height: i32) -> &'static mut [U8Clamped] {
    let dst = abi::alloc_array::<U8Clamped>(src.len());
    let mut y = 0.0;
    while y < f64::from(height) {
        let mut x = 0.0;
        while x < width {
            let mut c: i32 = 0;
            while c < 4 {
                let mut sum = 0.0;
                let mut count = 0.0;
                let mut dy: i32 = -1;
                while dy <= 1 {
                    let mut dx: i32 = -1;
                    while dx <= 1 {
                        let nx = x + f64::from(dx);
                        let ny = y + f64::from(dy);
                        if nx >= 0.0 && nx < width && ny >= 0.0 && ny < f64::from(height)
                        {
                            sum
                                += array::get(src, (ny * width + nx) * 4.0 + f64::from(c));
                            count += 1.0;
                        }
                        dx += 1;
                    }
                    dy += 1;
                }
                array::set(
                    dst,
                    (y * width + x) * 4.0 + f64::from(c),
                    sum / core::hint::black_box(count),
                );
                c += 1;
            }
            x += 1.0;
        }
        y += 1.0;
    }
    dst
}

fn histogram(pixels: &[U8Clamped], bins: &mut [u32]) {
    let mut i = 0.0;
    while i < array::len(pixels) {
        if conv::to_int32(i) & 3 != 3 {
            let index: i32 = ops::shr_i32(conv::to_int32(array::get(pixels, i)), 4);
            let value = array::get_i32(bins, index) + 1.0;
            array::set_i32(bins, index, value);
        }
        i += 1.0;
    }
}

#[unsafe(export_name = "brighten")]
pub unsafe extern "C" fn __abi_brighten(pixels_ptr: u32, pixels_len: u32, factor: f64) {
    // SAFETY: the glue passes fresh copies.
    let pixels = unsafe { abi::slice_mut::<U8Clamped>(pixels_ptr, pixels_len) };
    brighten(pixels, factor);
}

#[unsafe(export_name = "grayscale")]
pub unsafe extern "C" fn __abi_grayscale(pixels_ptr: u32, pixels_len: u32) {
    // SAFETY: the glue passes fresh copies.
    let pixels = unsafe { abi::slice_mut::<U8Clamped>(pixels_ptr, pixels_len) };
    grayscale(pixels);
}

#[unsafe(export_name = "boxBlur")]
pub unsafe extern "C" fn __abi_boxBlur(
    src_ptr: u32,
    src_len: u32,
    width: f64,
    height: i32,
) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let src = unsafe { abi::slice::<U8Clamped>(src_ptr, src_len) };
    abi::return_array(boxBlur(src, width, height))
}

#[unsafe(export_name = "histogram")]
pub unsafe extern "C" fn __abi_histogram(
    pixels_ptr: u32,
    pixels_len: u32,
    bins_ptr: u32,
    bins_len: u32,
) {
    // SAFETY: the glue passes fresh copies and checks they don't overlap.
    let pixels = unsafe { abi::slice::<U8Clamped>(pixels_ptr, pixels_len) };
    let bins = unsafe { abi::slice_mut::<u32>(bins_ptr, bins_len) };
    histogram(pixels, bins);
}
