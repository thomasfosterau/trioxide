//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

const STRIDE: f64 = 7.0;

fn advance(bodies: &mut [f64], dt: f64, steps: i32) {
    let n = array::len(bodies) / core::hint::black_box(STRIDE);
    let mut step = 0.0;
    while step < f64::from(steps) {
        let mut i = 0.0;
        while i < n {
            let bi = i * STRIDE;
            let mut j = i + 1.0;
            while j < n {
                let bj = j * STRIDE;
                let dx = array::get(bodies, bi) - array::get(bodies, bj);
                let dy = array::get(bodies, bi + 1.0) - array::get(bodies, bj + 1.0);
                let dz = array::get(bodies, bi + 2.0) - array::get(bodies, bj + 2.0);
                let mag = pull(dx, dy, dz, dt);
                let mi = array::get(bodies, bi + 6.0) * mag;
                let mj = array::get(bodies, bj + 6.0) * mag;
                array::set(bodies, bi + 3.0, array::get(bodies, bi + 3.0) - dx * mj);
                array::set(bodies, bi + 4.0, array::get(bodies, bi + 4.0) - dy * mj);
                array::set(bodies, bi + 5.0, array::get(bodies, bi + 5.0) - dz * mj);
                array::set(bodies, bj + 3.0, array::get(bodies, bj + 3.0) + dx * mi);
                array::set(bodies, bj + 4.0, array::get(bodies, bj + 4.0) + dy * mi);
                array::set(bodies, bj + 5.0, array::get(bodies, bj + 5.0) + dz * mi);
                j += 1.0;
            }
            i += 1.0;
        }
        let mut i_2 = 0.0;
        while i_2 < n {
            let b = i_2 * STRIDE;
            array::set(
                bodies,
                b,
                array::get(bodies, b) + dt * array::get(bodies, b + 3.0),
            );
            array::set(
                bodies,
                b + 1.0,
                array::get(bodies, b + 1.0) + dt * array::get(bodies, b + 4.0),
            );
            array::set(
                bodies,
                b + 2.0,
                array::get(bodies, b + 2.0) + dt * array::get(bodies, b + 5.0),
            );
            i_2 += 1.0;
        }
        step += 1.0;
    }
}

fn energy(bodies: &[f64]) -> f64 {
    let n = array::len(bodies) / core::hint::black_box(STRIDE);
    let mut e = 0.0;
    let mut i = 0.0;
    while i < n {
        let bi = i * STRIDE;
        let m = array::get(bodies, bi + 6.0);
        e
            += 0.5 * m
                * (array::get(bodies, bi + 3.0) * array::get(bodies, bi + 3.0)
                    + array::get(bodies, bi + 4.0) * array::get(bodies, bi + 4.0)
                    + array::get(bodies, bi + 5.0) * array::get(bodies, bi + 5.0));
        let mut j = i + 1.0;
        while j < n {
            let bj = j * STRIDE;
            e
                -= m * array::get(bodies, bj + 6.0)
                    / core::hint::black_box(
                        distance(
                            array::get(bodies, bi) - array::get(bodies, bj),
                            array::get(bodies, bi + 1.0) - array::get(bodies, bj + 1.0),
                            array::get(bodies, bi + 2.0) - array::get(bodies, bj + 2.0),
                        ),
                    );
            j += 1.0;
        }
        i += 1.0;
    }
    e
}

fn distance(dx: f64, dy: f64, dz: f64) -> f64 {
    math::sqrt(dx * dx + dy * dy + dz * dz)
}

fn pull(dx: f64, dy: f64, dz: f64, dt: f64) -> f64 {
    let d2 = dx * dx + dy * dy + dz * dz;
    dt / core::hint::black_box(d2 * math::sqrt(d2))
}

#[unsafe(export_name = "advance")]
pub unsafe extern "C" fn __abi_advance(
    bodies_ptr: u32,
    bodies_len: u32,
    dt: f64,
    steps: i32,
) {
    // SAFETY: the glue passes fresh copies.
    let bodies = unsafe { abi::slice_mut::<f64>(bodies_ptr, bodies_len) };
    advance(bodies, dt, steps);
}

#[unsafe(export_name = "energy")]
pub unsafe extern "C" fn __abi_energy(bodies_ptr: u32, bodies_len: u32) -> f64 {
    // SAFETY: the glue passes fresh copies.
    let bodies = unsafe { abi::slice::<f64>(bodies_ptr, bodies_len) };
    energy(bodies)
}

#[unsafe(export_name = "distance")]
pub extern "C" fn __abi_distance(dx: f64, dy: f64, dz: f64) -> f64 {
    distance(dx, dy, dz)
}
