//! WASM island `kernel`, generated by trioxide from `kernel.ts`. Do not edit.

#![no_std]
#![allow(non_snake_case, clippy::all)]

use trioxide_rt::prelude::*;

fn fnv1a(bytes: &[u8]) -> u32 {
    let mut hash = 2166136261.0;
    let mut i = 0.0;
    while i < array::len(bytes) {
        hash = f64::from(conv::to_int32(hash) ^ conv::to_int32(array::get(bytes, i)));
        hash = f64::from(math::imul(hash, 16777619.0));
        i += 1.0;
    }
    conv::to_uint32(hash)
}

fn crc32(bytes: &[u8]) -> u32 {
    let table = abi::alloc_array::<i32>(256);
    let mut n: i32 = 0;
    while n < 256 {
        let mut c: i32 = n;
        let mut k: i32 = 0;
        while k < 8 {
            c = (if c & 1 != 0 {
                f64::from(3988292384_u32 as i32 ^ ops::ushr_i32(c, 1) as i32)
            } else {
                f64::from(ops::ushr_i32(c, 1))
            }) as i32;
            k += 1;
        }
        array::set_i32(table, n, f64::from(c));
        n += 1;
    }
    let mut crc: i32 = -1;
    let mut i = 0.0;
    while i < array::len(bytes) {
        crc = conv::to_int32(
            array::get_i32(table, (crc ^ conv::to_int32(array::get(bytes, i))) & 255),
        ) ^ ops::ushr_i32(crc, 8) as i32;
        i += 1.0;
    }
    (crc ^ -1) as u32
}

fn popcount(x: f64) -> f64 {
    let mut v: i32 = conv::to_int32(x);
    let mut count = 0.0;
    while v != 0 {
        v &= conv::to_int32(f64::from(v) - 1.0);
        count += 1.0;
    }
    count
}

fn xorshift(seed: f64, out: &mut [i32]) -> i32 {
    let mut x: i32 = {
        let lhs = conv::to_int32(seed);
        if lhs != 0 { lhs } else { 1 }
    };
    let mut i = 0.0;
    while i < array::len(out) {
        x ^= ops::shl_i32(x, 13);
        x ^= ops::shr_i32(x, 17);
        x ^= ops::shl_i32(x, 5);
        array::set(out, i, f64::from(x));
        i += 1.0;
    }
    x
}

fn reverseBits(x: f64) -> u32 {
    let mut v: u32 = conv::to_uint32(x);
    let mut r: i32 = 0;
    let mut i: i32 = 0;
    while i < 32 {
        r = ops::shl_i32(r, 1) | v as i32 & 1;
        v = ops::ushr_i32(v as i32, 1);
        i += 1;
    }
    r as u32
}

fn packRgba(r: f64, g: f64, b: f64, a: f64) -> u32 {
    (ops::shl_i32(conv::to_int32(a) & 255, 24)
        | ops::shl_i32(conv::to_int32(b) & 255, 16)
        | ops::shl_i32(conv::to_int32(g) & 255, 8) | conv::to_int32(r) & 255) as u32
}

#[unsafe(export_name = "fnv1a")]
pub unsafe extern "C" fn __abi_fnv1a(bytes_ptr: u32, bytes_len: u32) -> u32 {
    // SAFETY: the glue passes fresh copies.
    let bytes = unsafe { abi::slice::<u8>(bytes_ptr, bytes_len) };
    fnv1a(bytes)
}

#[unsafe(export_name = "crc32")]
pub unsafe extern "C" fn __abi_crc32(bytes_ptr: u32, bytes_len: u32) -> u32 {
