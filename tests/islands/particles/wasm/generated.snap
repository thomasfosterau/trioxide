fn centroid(xs: &[f64], ys: &[f64]) -> Centroid {
    let mut sum = Vec2::new(0.0, 0.0);
    let n = math::min(array::len(xs), array::len(ys));
    let mut i = 0.0;
    while i < n {
        sum = sum.add(Vec2::new(array::get(xs, i), array::get(ys, i)));
        i += 1.0;
