    }
    let total = a.mass + b.mass;
    let vx = (a.vx * a.mass + b.vx * b.mass) / core::hint::black_box(total);
    let vy = (a.vy * a.mass + b.vy * b.mass) / core::hint::black_box(total);
    a.vx = vx;
    a.vy = vy;
    b.vx = vx;
    b.vy = vy;
    a.mass += 0.5;
    b.mass += 0.25;
