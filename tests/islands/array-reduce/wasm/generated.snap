use trioxide_rt::prelude::*;
/// `{ min, max, mean }`, the object literal `stats` returns (`structs[0]` in the spec).
#[repr(C)]
#[derive(Clone, Copy)]
pub struct Stats {
    pub min: f64,
    pub max: f64,
    pub mean: f64,
}
const _: () = {
    assert!(size_of::<Stats>() == 24 && align_of::<Stats>() == 8);
    assert!(core::mem::offset_of!(Stats, max) == 8);
    assert!(core::mem::offset_of!(Stats, mean) == 16);
};
fn sum(values: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(values) {
        total += array::get(values, i);
        i += 1.0;
    }
    total
}
fn stats(values: &[f64]) -> Stats {
    let mut min = f64::INFINITY;
    let mut max = f64::NEG_INFINITY;
    let mut total = 0.0;
    for index in 0..values.len() {
        // SAFETY: the loop keeps the index below the length.
        let value = unsafe { array::get_unchecked(values, index) };
        min = math::min(min, value);
        max = math::max(max, value);
        total += value;
    }
    Stats {
        min,
        max,
        mean: total / core::hint::black_box(array::len(values)),
    }
}
fn dot(a: &[f64], b: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(a) {
        // SAFETY: the analysis proves the index is in bounds.
        total += unsafe { array::get_unchecked(a, i as usize) } * array::get(b, i);
        i += 1.0;
    }
    total
}
fn normalize(values: &mut [f64]) {
    let total = sum(values);
    let mut i = 0.0;
    while i < array::len(values) {
        array::set(values, i, array::get(values, i) / core::hint::black_box(total));
        i += 1.0;
    }
}
fn prefixSums(values: &[f64]) -> &'static mut [f64] {
    let out = abi::alloc_array::<f64>(values.len());
    let mut total = 0.0;
    let mut i = 0.0;
    while i < array::len(values) {
        total += array::get(values, i);
        array::set(out, i, total);
        i += 1.0;
    }
    out
}
fn weightedMean(values: &[f64], weights: &[f64]) -> f64 {
    let mut total = 0.0;
    let mut weight = 0.0;
    let mut i = 0.0;
    while i < array::len(values) {
        // SAFETY: the analysis proves the index is in bounds.
        total
            += unsafe { array::get_unchecked(values, i as usize) }
                * array::get(weights, i);
        weight += array::get(weights, i);
        i += 1.0;
    }
    total / core::hint::black_box(weight)
}
