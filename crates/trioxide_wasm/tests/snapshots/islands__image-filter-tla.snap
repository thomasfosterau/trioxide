// Glue for the WASM island "image-filter" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   brighten(pixels: Uint8ClampedArray, factor: number): void  (copies back pixels)
//   grayscale(pixels: Uint8ClampedArray): void  (copies back pixels)
//   boxBlur(src: Uint8ClampedArray, width: number, height: number): Uint8ClampedArray
//   histogram(pixels: Uint8ClampedArray, bins: Uint32Array): void  (copies back bins)

import * as $fallback from "../kernel.fallback.js";

const $url = new URL("./image-filter.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "image-filter" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "image-filter" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length (in ${name}(), island "image-filter")`);
  return new Error(`trioxide: island "image-filter" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// Copies a typed array or number[] into the arena as View elements.
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

function $copyBack(array, View, ptr) {
  array.set(new View($wasm.memory.buffer, ptr, array.length));
}

function $takeArray(ret, View) {
  const [ptr, length] = new Uint32Array($wasm.memory.buffer, ret, 2);
  return new View($wasm.memory.buffer, ptr, length).slice();
}

function $overlaps(a, b) {
  if (a === b) return true;
  if (Array.isArray(a) || Array.isArray(b) || a.buffer !== b.buffer) return false;
  return a.byteOffset < b.byteOffset + b.byteLength && b.byteOffset < a.byteOffset + a.byteLength;
}

export function brighten(pixels, factor) {
  try {
    const $0 = $copyIn(pixels, Uint8ClampedArray);
    $wasm.brighten($0, pixels.length, factor);
    $copyBack(pixels, Uint8ClampedArray, $0);
  } catch ($error) {
    throw $trap($error, "brighten");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function grayscale(pixels) {
  try {
    const $0 = $copyIn(pixels, Uint8ClampedArray);
    $wasm.grayscale($0, pixels.length);
    $copyBack(pixels, Uint8ClampedArray, $0);
  } catch ($error) {
    throw $trap($error, "grayscale");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function boxBlur(src, width, height) {
  try {
    const $0 = $copyIn(src, Uint8ClampedArray);
    const $ret = $wasm.boxBlur($0, src.length, width, height);
    return $takeArray($ret, Uint8ClampedArray);
  } catch ($error) {
    throw $trap($error, "boxBlur");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function histogram(pixels, bins) {
  if ($overlaps(pixels, bins)) {
    return $fallback.histogram(pixels, bins);
  }
  try {
    const $0 = $copyIn(pixels, Uint8ClampedArray);
    const $1 = $copyIn(bins, Uint32Array);
    $wasm.histogram($0, pixels.length, $1, bins.length);
    $copyBack(bins, Uint32Array, $1);
  } catch ($error) {
    throw $trap($error, "histogram");
  } finally {
    $wasm.__trioxide_reset();
  }
