// Glue for the WASM island "errors" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   filled(length: number, value: number): Float64Array
//   total(length: number): number

const $url = new URL("./errors.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "errors" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "errors" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length: ${$wasm.__trioxide_trap_value()}`);
  return new Error(`trioxide: island "errors" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

function $takeArray(ret, View) {
  const [ptr, length] = new Uint32Array($wasm.memory.buffer, ret, 2);
  return new View($wasm.memory.buffer, ptr, length).slice();
}

export function filled(length, value) {
  try {
    const $ret = $wasm.filled(length, value);
    return $takeArray($ret, Float64Array);
  } catch ($error) {
    throw $trap($error, "filled");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function total(length) {
  try {
    return $wasm.total(length);
  } catch ($error) {
    throw $trap($error, "total");
  } finally {
    $wasm.__trioxide_reset();
  }
}
