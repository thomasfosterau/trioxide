// Glue for the WASM island "multi" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   identity(n: number): Float64Array
//   multiply(a: Float64Array, b: Float64Array, n: number): Float64Array
//   power(m: Float64Array, n: number, k: number): Float64Array
//   trace(m: Float64Array, n: number): number
//   determinant(m: Float64Array, n: number): number
//   axpy(y: Float64Array, x: Float64Array, alpha: number): void  (copies back y)

import * as $fallback from "../kernel.fallback.js";

const $url = new URL("./multi.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

let $wasm;
const $ready = $instantiate().then((exports) => {
  $wasm = exports;
});
// Rejections surface through ready(); don't also report them as unhandled.
$ready.catch(() => {});

/** Resolves once the island is instantiated. Its functions throw until then. */
export function ready() {
  return $ready;
}

function $check() {
  if ($wasm === undefined) throw new Error('trioxide: island "multi" is not ready; await ready() first');
}

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "multi" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "multi" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length (in ${name}(), island "multi")`);
  return new Error(`trioxide: island "multi" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// Copies a typed array or number[] into the arena as View elements.
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

function $copyBack(array, View, ptr) {
  array.set(new View($wasm.memory.buffer, ptr, array.length));
}

function $takeArray(ret, View) {
  const [ptr, length] = new Uint32Array($wasm.memory.buffer, ret, 2);
  return new View($wasm.memory.buffer, ptr, length).slice();
}

function $overlaps(a, b) {
  if (a === b) return true;
  if (Array.isArray(a) || Array.isArray(b) || a.buffer !== b.buffer) return false;
  return a.byteOffset < b.byteOffset + b.byteLength && b.byteOffset < a.byteOffset + a.byteLength;
}

export function identity(n) {
  $check();
  try {
    const $ret = $wasm.identity(n);
    return $takeArray($ret, Float64Array);
  } catch ($error) {
    throw $trap($error, "identity");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function multiply(a, b, n) {
  $check();
  try {
    const $0 = $copyIn(a, Float64Array);
    const $1 = $copyIn(b, Float64Array);
    const $ret = $wasm.multiply($0, a.length, $1, b.length, n);
    return $takeArray($ret, Float64Array);
  } catch ($error) {
    throw $trap($error, "multiply");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function power(m, n, k) {
  $check();
  try {
    const $0 = $copyIn(m, Float64Array);
    const $ret = $wasm.power($0, m.length, n, k);
    return $takeArray($ret, Float64Array);
  } catch ($error) {
    throw $trap($error, "power");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function trace(m, n) {
  $check();
  try {
    const $0 = $copyIn(m, Float64Array);
    return $wasm.trace($0, m.length, n);
  } catch ($error) {
    throw $trap($error, "trace");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function determinant(m, n) {
  $check();
  try {
    const $0 = $copyIn(m, Float64Array);
    return $wasm.determinant($0, m.length, n);
  } catch ($error) {
    throw $trap($error, "determinant");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function axpy(y, x, alpha) {
  $check();
  if ($overlaps(y, x)) {
    return $fallback.axpy(y, x, alpha);
  }
  try {
    const $0 = $copyIn(y, Float64Array);
    const $1 = $copyIn(x, Float64Array);
    $wasm.axpy($0, y.length, $1, x.length, alpha);
    $copyBack(y, Float64Array, $0);
  } catch ($error) {
    throw $trap($error, "axpy");
  } finally {
    $wasm.__trioxide_reset();
  }
}
