// Glue for the WASM island "nbody" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   advance(bodies: Float64Array, dt: number, steps: number): void  (copies back bodies)
//   energy(bodies: Float64Array): number
//   distance(dx: number, dy: number, dz: number): number

const $url = new URL("./nbody.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

// `var`: a module this glue imports (its fallback) may call a wrapper before this body runs.
var $wasm;
var $ready = $instantiate().then((exports) => {
  $wasm = exports;
});
// Rejections surface through ready(); don't also report them as unhandled.
$ready.catch(() => {});

/** Resolves once the island is instantiated. Until then its functions run their JS versions
 * (the spec's fallback), or throw if there is none. */
export function ready() {
  return $ready;
}

function $check() {
  if ($wasm === undefined) throw new Error('trioxide: island "nbody" is not ready; await ready() first');
}

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "nbody" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "nbody" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length: ${$wasm.__trioxide_trap_value()}`);
  return new Error(`trioxide: island "nbody" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// Copies a typed array into the arena as View elements. (A detached one has no elements,
// and `set` would throw.)
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  if (array.length !== 0) new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

function $copyBack(array, View, ptr) {
  if (array.length !== 0) array.set(new View($wasm.memory.buffer, ptr, array.length));
}

export function advance(bodies, dt, steps) {
  $check();
  let $0;
  let $called = false;
  try {
    $0 = $copyIn(bodies, Float64Array);
    $called = true;
    $wasm.advance($0, bodies.length, dt, steps);
  } catch ($error) {
    throw $trap($error, "advance");
  } finally {
    if ($called) {
      $copyBack(bodies, Float64Array, $0);
    }
    $wasm.__trioxide_reset();
  }
}

export function energy(bodies) {
  $check();
  try {
    const $0 = $copyIn(bodies, Float64Array);
    return $wasm.energy($0, bodies.length);
  } catch ($error) {
    throw $trap($error, "energy");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function distance(dx, dy, dz) {
  $check();
  try {
    return $wasm.distance(dx, dy, dz);
  } catch ($error) {
    throw $trap($error, "distance");
  } finally {
    $wasm.__trioxide_reset();
  }
}
