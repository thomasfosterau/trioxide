// Glue for the WASM island "array-reduce" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   sum(values: number[]): number
//   stats(values: number[]): Stats
//   dot(a: number[], b: number[]): number
//   normalize(values: number[]): void  (copies back values)
//   prefixSums(values: number[]): number[]
//   weightedMean(values: number[], weights: Float64Array): number

const $url = new URL("./array-reduce.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "array-reduce" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "array-reduce" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length (in ${name}(), island "array-reduce")`);
  return new Error(`trioxide: island "array-reduce" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// Copies a typed array or number[] into the arena as View elements.
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

// Writes back only the elements that changed, so holes stay holes.
function $copyBackNumbers(array, ptr) {
  const view = new Float64Array($wasm.memory.buffer, ptr, array.length);
  for (let i = 0; i < view.length; i++) if (!Object.is(view[i], +array[i])) array[i] = view[i];
}

function $takeNumbers(ret) {
  const [ptr, length] = new Uint32Array($wasm.memory.buffer, ret, 2);
  return Array.from(new Float64Array($wasm.memory.buffer, ptr, length));
}

function $readStats(view, ptr) {
  return {
    min: view.getFloat64(ptr, true),
    max: view.getFloat64(ptr + 8, true),
    mean: view.getFloat64(ptr + 16, true),
  };
}

export function sum(values) {
  try {
    const $0 = $copyIn(values, Float64Array);
    return $wasm.sum($0, values.length);
  } catch ($error) {
    throw $trap($error, "sum");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function stats(values) {
  try {
    const $0 = $copyIn(values, Float64Array);
    const $ret = $wasm.stats($0, values.length);
    return $readStats(new DataView($wasm.memory.buffer), $ret);
  } catch ($error) {
    throw $trap($error, "stats");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function dot(a, b) {
  try {
    const $0 = $copyIn(a, Float64Array);
    const $1 = $copyIn(b, Float64Array);
    return $wasm.dot($0, a.length, $1, b.length);
  } catch ($error) {
    throw $trap($error, "dot");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function normalize(values) {
  try {
    const $0 = $copyIn(values, Float64Array);
    $wasm.normalize($0, values.length);
    $copyBackNumbers(values, $0);
  } catch ($error) {
    throw $trap($error, "normalize");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function prefixSums(values) {
  try {
    const $0 = $copyIn(values, Float64Array);
    const $ret = $wasm.prefixSums($0, values.length);
    return $takeNumbers($ret);
  } catch ($error) {
    throw $trap($error, "prefixSums");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function weightedMean(values, weights) {
  try {
    const $0 = $copyIn(values, Float64Array);
    const $1 = $copyIn(weights, Float64Array);
    return $wasm.weightedMean($0, values.length, $1, weights.length);
  } catch ($error) {
    throw $trap($error, "weightedMean");
  } finally {
    $wasm.__trioxide_reset();
  }
}
