// Glue for the WASM island "bitwise" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   fnv1a(bytes: Uint8Array): number
//   crc32(bytes: Uint8Array): number
//   popcount(x: number): number
//   xorshift(seed: number, out: Int32Array): number  (copies back out)
//   reverseBits(x: number): number
//   packRgba(r: number, g: number, b: number, a: number): number

const $url = new URL("./bitwise.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "bitwise" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "bitwise" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length: ${$wasm.__trioxide_trap_value()}`);
  return new Error(`trioxide: island "bitwise" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// The intrinsic length of a typed array: the island sees that many elements, so an argument
// whose `length` property says otherwise (an own or inherited override) runs the JS version.
const $typedLength = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Int8Array.prototype), 'length').get;

function $plainView(array) {
  try {
    return $typedLength.call(array) === array.length;
  } catch {
    return false;
  }
}

// Copies a typed array into the arena as View elements. (A detached one has no elements,
// and `set` would throw.)
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  if (array.length !== 0) new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

function $copyBack(array, View, ptr) {
  if (array.length !== 0) array.set(new View($wasm.memory.buffer, ptr, array.length));
}

export function fnv1a(bytes) {
  if (!$plainView(bytes)) {
    throw new TypeError('trioxide: fnv1a() got an argument with a `length` or fields that aren\'t plain data properties, which island "bitwise" cannot handle');
  }
  try {
    const $0 = $copyIn(bytes, Uint8Array);
    const $ret = $wasm.fnv1a($0, bytes.length);
    return $ret >>> 0;
  } catch ($error) {
    throw $trap($error, "fnv1a");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function crc32(bytes) {
  if (!$plainView(bytes)) {
    throw new TypeError('trioxide: crc32() got an argument with a `length` or fields that aren\'t plain data properties, which island "bitwise" cannot handle');
  }
  try {
    const $0 = $copyIn(bytes, Uint8Array);
    const $ret = $wasm.crc32($0, bytes.length);
    return $ret >>> 0;
  } catch ($error) {
    throw $trap($error, "crc32");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function popcount(x) {
  try {
    return $wasm.popcount(x);
  } catch ($error) {
    throw $trap($error, "popcount");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function xorshift(seed, out) {
  if (!$plainView(out)) {
    throw new TypeError('trioxide: xorshift() got an argument with a `length` or fields that aren\'t plain data properties, which island "bitwise" cannot handle');
  }
  let $1;
  let $called = false;
  try {
    $1 = $copyIn(out, Int32Array);
    $called = true;
    return $wasm.xorshift(seed, $1, out.length);
  } catch ($error) {
    throw $trap($error, "xorshift");
  } finally {
    if ($called) {
      $copyBack(out, Int32Array, $1);
    }
    $wasm.__trioxide_reset();
  }
}

export function reverseBits(x) {
  try {
    const $ret = $wasm.reverseBits(x);
    return $ret >>> 0;
  } catch ($error) {
    throw $trap($error, "reverseBits");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function packRgba(r, g, b, a) {
  try {
    const $ret = $wasm.packRgba(r, g, b, a);
    return $ret >>> 0;
  } catch ($error) {
    throw $trap($error, "packRgba");
  } finally {
    $wasm.__trioxide_reset();
  }
}
