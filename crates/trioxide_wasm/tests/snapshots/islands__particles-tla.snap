// Glue for the WASM island "particles" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   centroid(xs: Float64Array, ys: Float64Array): Point
//   spread(xs: Float64Array, ys: Float64Array): number
//   step(body: Body, ax: number, ay: number, dt: number): void  (copies back body)
//   collide(a: Body, b: Body): boolean  (copies back a, b)
//   momentum(a: Body, b: Body): number

import * as $fallback from "../kernel.fallback.js";

const $url = new URL("./particles.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "particles" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "particles" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length: ${$wasm.__trioxide_trap_value()}`);
  return new Error(`trioxide: island "particles" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// The intrinsic length of a typed array: the island sees that many elements, so an argument
// whose `length` property says otherwise (an own or inherited override) runs the JS version.
const $typedLength = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Int8Array.prototype), 'length').get;

function $plainView(array) {
  try {
    return $typedLength.call(array) === array.length;
  } catch {
    return false;
  }
}

// Copies a typed array into the arena as View elements. (A detached one has no elements,
// and `set` would throw.)
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  if (array.length !== 0) new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

// An own data property (a writable one if the island may write it): copying it in and back
// then reads and writes it as JS would. Otherwise the call runs the JS version.
function $isData(object, name, writable) {
  const property =
    typeof object === 'object' && object !== null ? Object.getOwnPropertyDescriptor(object, name) : undefined;
  return property !== undefined && 'value' in property && (!writable || property.writable);
}

// Whether the island changed `size` bytes at `at` since `before` (from `from`) was taken: only
// fields it wrote are copied back.
function $changed(view, at, before, from, size) {
  for (let i = 0; i < size; i++) if (view.getUint8(at + i) !== before[from + i]) return true;
  return false;
}

function $plainBody(value, writable) {
  return $isData(value, "x", writable) && $isData(value, "y", writable) && $isData(value, "vx", writable) && $isData(value, "vy", writable) && $isData(value, "mass", writable) && $isData(value, "layer", writable) && $isData(value, "pinned", writable);
}

function $writeBody(view, ptr, value) {
  view.setFloat64(ptr, value.x, true);
  view.setFloat64(ptr + 8, value.y, true);
  view.setFloat64(ptr + 16, value.vx, true);
  view.setFloat64(ptr + 24, value.vy, true);
  view.setFloat64(ptr + 32, value.mass, true);
  view.setInt32(ptr + 40, value.layer, true);
  view.setUint8(ptr + 44, value.pinned ? 1 : 0);
}

function $updateBody(view, ptr, value, before, base) {
  if ($changed(view, ptr, before, base, 8)) value.x = view.getFloat64(ptr, true);
  if ($changed(view, ptr + 8, before, base + 8, 8)) value.y = view.getFloat64(ptr + 8, true);
  if ($changed(view, ptr + 16, before, base + 16, 8)) value.vx = view.getFloat64(ptr + 16, true);
  if ($changed(view, ptr + 24, before, base + 24, 8)) value.vy = view.getFloat64(ptr + 24, true);
  if ($changed(view, ptr + 32, before, base + 32, 8)) value.mass = view.getFloat64(ptr + 32, true);
  if ($changed(view, ptr + 40, before, base + 40, 4)) value.layer = view.getInt32(ptr + 40, true);
  if ($changed(view, ptr + 44, before, base + 44, 1)) value.pinned = view.getUint8(ptr + 44) !== 0;
}

function $readPoint(view, ptr) {
  return {
    x: view.getFloat64(ptr, true),
    y: view.getFloat64(ptr + 8, true),
  };
}

export function centroid(xs, ys) {
  if (!$plainView(xs) || !$plainView(ys)) {
    return $fallback.centroid(xs, ys);
  }
  try {
    const $0 = $copyIn(xs, Float64Array);
    const $1 = $copyIn(ys, Float64Array);
    const $ret = $wasm.centroid($0, xs.length, $1, ys.length);
    return $readPoint(new DataView($wasm.memory.buffer), $ret);
  } catch ($error) {
    throw $trap($error, "centroid");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function spread(xs, ys) {
  if (!$plainView(xs) || !$plainView(ys)) {
    return $fallback.spread(xs, ys);
  }
  try {
    const $0 = $copyIn(xs, Float64Array);
    const $1 = $copyIn(ys, Float64Array);
    return $wasm.spread($0, xs.length, $1, ys.length);
  } catch ($error) {
    throw $trap($error, "spread");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function step(body, ax, ay, dt) {
  if (!$plainBody(body, true)) {
    return $fallback.step(body, ax, ay, dt);
  }
  let $0, $0b;
  let $called = false;
  try {
    $0 = $alloc(48, 8);
    $writeBody(new DataView($wasm.memory.buffer), $0, body);
    $0b = new Uint8Array($wasm.memory.buffer, $0, 48).slice();
    $called = true;
    $wasm.step($0, ax, ay, dt);
  } catch ($error) {
    throw $trap($error, "step");
  } finally {
    if ($called) {
      $updateBody(new DataView($wasm.memory.buffer), $0, body, $0b, 0);
    }
    $wasm.__trioxide_reset();
  }
}

export function collide(a, b) {
  if (a === b) {
    return $fallback.collide(a, b);
  }
  if (!$plainBody(a, true) || !$plainBody(b, true)) {
    return $fallback.collide(a, b);
  }
  let $0, $0b, $1, $1b;
  let $called = false;
  try {
    $0 = $alloc(48, 8);
    $writeBody(new DataView($wasm.memory.buffer), $0, a);
    $0b = new Uint8Array($wasm.memory.buffer, $0, 48).slice();
    $1 = $alloc(48, 8);
    $writeBody(new DataView($wasm.memory.buffer), $1, b);
    $1b = new Uint8Array($wasm.memory.buffer, $1, 48).slice();
    $called = true;
    const $ret = $wasm.collide($0, $1);
    return $ret !== 0;
  } catch ($error) {
    throw $trap($error, "collide");
  } finally {
    if ($called) {
      $updateBody(new DataView($wasm.memory.buffer), $0, a, $0b, 0);
      $updateBody(new DataView($wasm.memory.buffer), $1, b, $1b, 0);
    }
    $wasm.__trioxide_reset();
  }
}

export function momentum(a, b) {
  if (!$plainBody(a, false) || !$plainBody(b, false)) {
    return $fallback.momentum(a, b);
  }
  try {
    const $0 = $alloc(48, 8);
    $writeBody(new DataView($wasm.memory.buffer), $0, a);
    const $1 = $alloc(48, 8);
    $writeBody(new DataView($wasm.memory.buffer), $1, b);
    return $wasm.momentum($0, $1);
  } catch ($error) {
    throw $trap($error, "momentum");
  } finally {
    $wasm.__trioxide_reset();
  }
}
