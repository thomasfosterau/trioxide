// Glue for the WASM island "math-edge" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   round(x: number): number
//   sign(x: number): number
//   trunc(x: number): number
//   fround(x: number): number
//   max(a: number, b: number): number
//   min3(a: number, b: number, c: number): number
//   hypot(a: number, b: number, c: number): number
//   rem(a: number, b: number): number
//   clz32(x: number): number
//   imul(a: number, b: number): number
//   toInt32(x: number): number
//   toUint32(x: number): number
//   mix(a: number, b: number): number
//   idiv(a: number, b: number): number
//   irem(a: number, b: number): number
//   wrapAdd(a: number, b: number): number
//   isPositive(x: number): boolean
//   notLess(a: number, b: number): boolean
//   choose(flag: boolean, a: number, b: number): number
//   truthy(x: number): boolean
//   clampByte(x: number): number

const $url = new URL("./math-edge.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

const $wasm = await $instantiate();

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "math-edge" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "math-edge" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length (in ${name}(), island "math-edge")`);
  return new Error(`trioxide: island "math-edge" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

export function round(x) {
  try {
    return $wasm.round(x);
  } catch ($error) {
    throw $trap($error, "round");
  } finally {
    $wasm.__trioxide_reset();
  }
}

