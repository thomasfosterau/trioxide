// Glue for the WASM island "array-reduce" (trioxide ABI 1). Generated by trioxide; do not edit.
//
//   sum(values: number[]): number
//   stats(values: number[]): Stats
//   dot(a: number[], b: number[]): number
//   normalize(values: number[]): void  (copies back values)
//   prefixSums(values: number[]): number[]
//   weightedMean(values: number[], weights: Float64Array): number

const $url = new URL("./array-reduce.wasm", import.meta.url);

async function $instantiate() {
  let bytes;
  if ($url.protocol === "file:") {
    const fs = "node:fs/promises";
    bytes = await (await import(/* @vite-ignore */ fs)).readFile($url);
  } else {
    const response = await fetch($url);
    if (!response.ok) throw new Error(`trioxide: cannot load ${$url}: HTTP ${response.status}`);
    bytes = await response.arrayBuffer();
  }
  const { instance } = await WebAssembly.instantiate(bytes, {});
  const version = instance.exports.__trioxide_abi_version();
  if (version !== 1) throw new Error(`trioxide: ${$url} implements island ABI ${version}, expected 1`);
  return instance.exports;
}

// `var`: a module this glue imports (its fallback) may call a wrapper before this body runs.
var $wasm;
var $ready = $instantiate().then((exports) => {
  $wasm = exports;
});
// Rejections surface through ready(); don't also report them as unhandled.
$ready.catch(() => {});

/** Resolves once the island is instantiated. Until then its functions run their JS versions
 * (the spec's fallback), or throw if there is none. */
export function ready() {
  return $ready;
}

function $check() {
  if ($wasm === undefined) throw new Error('trioxide: island "array-reduce" is not ready; await ready() first');
}

function $alloc(bytes, align) {
  const ptr = $wasm.__trioxide_alloc(bytes, align);
  if (ptr === 0) throw new RangeError('trioxide: island "array-reduce" is out of memory');
  return ptr;
}

function $trap(error, name) {
  if (!(error instanceof WebAssembly.RuntimeError)) return error;
  const code = $wasm.__trioxide_trap_code();
  if (code === 1) return new RangeError(`trioxide: island "array-reduce" ran out of memory in ${name}()`);
  if (code === 2) return new RangeError(`Invalid typed array length: ${$wasm.__trioxide_trap_value()}`);
  return new Error(`trioxide: island "array-reduce" trapped in ${name}(); this is a trioxide bug`, { cause: error });
}

// The intrinsic length of a typed array: the island sees that many elements, so an argument
// whose `length` property says otherwise (an own or inherited override) runs the JS version.
const $typedLength = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Int8Array.prototype), 'length').get;

function $plainView(array) {
  try {
    return $typedLength.call(array) === array.length;
  } catch {
    return false;
  }
}

// Copies a typed array into the arena as View elements. (A detached one has no elements,
// and `set` would throw.)
function $copyIn(array, View) {
  const ptr = $alloc(array.length * View.BYTES_PER_ELEMENT, View.BYTES_PER_ELEMENT);
  if (array.length !== 0) new View($wasm.memory.buffer, ptr, array.length).set(array);
  return ptr;
}

// A number[] element that is `undefined` (a hole) enters the island as a signalling NaN
// (trioxide_rt `array::HOLE`), which arithmetic turns into an ordinary NaN and which the
// island never stores: elements still holding it weren't written.
const $HOLE_HI = 0x7ff47472;
const $HOLE_LO = 0x696f7869;

function $isHole(words, i) {
  return words[2 * i] === $HOLE_LO && words[2 * i + 1] === $HOLE_HI;
}

function $copyInNumbers(array) {
  const ptr = $alloc(array.length * 8, 8);
  if (array.length !== 0) {
    new Float64Array($wasm.memory.buffer, ptr, array.length).set(array);
    const words = new Uint32Array($wasm.memory.buffer, ptr, array.length * 2);
    for (let i = 0; i < array.length; i++) {
      if (array[i] === undefined) {
        words[2 * i] = $HOLE_LO;
        words[2 * i + 1] = $HOLE_HI;
      }
    }
  }
  return ptr;
}

// Writes back only the elements that changed, so holes the island didn't write stay holes.
function $copyBackNumbers(array, ptr) {
  const view = new Float64Array($wasm.memory.buffer, ptr, array.length);
  const words = new Uint32Array($wasm.memory.buffer, ptr, array.length * 2);
  for (let i = 0; i < view.length; i++) {
    if (!$isHole(words, i) && !Object.is(view[i], array[i])) array[i] = view[i];
  }
}

function $takeNumbers(ret) {
  const [ptr, length] = new Uint32Array($wasm.memory.buffer, ret, 2);
  return Array.from(new Float64Array($wasm.memory.buffer, ptr, length));
}

function $readStats(view, ptr) {
  return {
    min: view.getFloat64(ptr, true),
    max: view.getFloat64(ptr + 8, true),
    mean: view.getFloat64(ptr + 16, true),
  };
}

export function sum(values) {
  $check();
  try {
    const $0 = $copyInNumbers(values);
    return $wasm.sum($0, values.length);
  } catch ($error) {
    throw $trap($error, "sum");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function stats(values) {
  $check();
  try {
    const $0 = $copyInNumbers(values);
    const $ret = $wasm.stats($0, values.length);
    return $readStats(new DataView($wasm.memory.buffer), $ret);
  } catch ($error) {
    throw $trap($error, "stats");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function dot(a, b) {
  $check();
  try {
    const $0 = $copyInNumbers(a);
    const $1 = $copyInNumbers(b);
    return $wasm.dot($0, a.length, $1, b.length);
  } catch ($error) {
    throw $trap($error, "dot");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function normalize(values) {
  $check();
  let $0;
  let $called = false;
  try {
    $0 = $copyInNumbers(values);
    $called = true;
    $wasm.normalize($0, values.length);
  } catch ($error) {
    throw $trap($error, "normalize");
  } finally {
    if ($called) {
      $copyBackNumbers(values, $0);
    }
    $wasm.__trioxide_reset();
  }
}

export function prefixSums(values) {
  $check();
  try {
    const $0 = $copyInNumbers(values);
    const $ret = $wasm.prefixSums($0, values.length);
    return $takeNumbers($ret);
  } catch ($error) {
    throw $trap($error, "prefixSums");
  } finally {
    $wasm.__trioxide_reset();
  }
}

export function weightedMean(values, weights) {
  $check();
  if (!$plainView(weights)) {
    throw new TypeError('trioxide: weightedMean() got an argument with a `length` or fields that aren\'t plain data properties, which island "array-reduce" cannot handle');
  }
  try {
    const $0 = $copyInNumbers(values);
    const $1 = $copyIn(weights, Float64Array);
    return $wasm.weightedMean($0, values.length, $1, weights.length);
  } catch ($error) {
    throw $trap($error, "weightedMean");
  } finally {
    $wasm.__trioxide_reset();
  }
}
